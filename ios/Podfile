require_relative '../node_modules/react-native/scripts/react_native_pods'
require_relative '../node_modules/@react-native-community/cli-platform-ios/native_modules'

# Set platform to iOS 13.0 to support latest features while maintaining wide compatibility
platform :ios, '13.0'
prepare_react_native_project!

# Enable Flipper by default in Debug mode
production = ENV["PRODUCTION"] == "1"
if production
  flipper_config = FlipperConfiguration.disabled
else
  flipper_config = FlipperConfiguration.enabled
end

# Use frameworks for better compatibility with Swift
use_frameworks! :linkage => :static

# Performance optimization flags
ENV['CC'] = 'clang'
ENV['CXX'] = 'clang++'
ENV['CFLAGS'] = '-Ofast'
ENV['CXXFLAGS'] = '-Ofast'

# Enable Hermes
ENV['USE_HERMES'] = '1'

target 'Kindred' do
  config = use_native_modules!
  
  # React Native dependency
  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => true,
    :fabric_enabled => false, # Disabled until more stable
    :flipper_configuration => flipper_config,
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Firebase dependencies with modular headers for better build times
  pod 'Firebase', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true

  # Development pods
  if !production
    pod 'RCT-Folly', :podspec => '../node_modules/react-native/third-party-podspecs/RCT-Folly.podspec'
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => true
    )

    # Optimization flags for all targets
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        # Enable compiler optimizations
        config.build_settings['GCC_OPTIMIZATION_LEVEL'] = 's'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-O'
        config.build_settings['SWIFT_COMPILATION_MODE'] = 'wholemodule'
        
        # Enable module stability
        config.build_settings['SWIFT_ENFORCE_EXCLUSIVE_ACCESS'] = 'compile-time'
        config.build_settings['CLANG_ENABLE_MODULE_DEBUGGING'] = 'NO'
        
        # Enable bitcode for release builds
        if config.name == 'Release'
          config.build_settings['BITCODE_GENERATION_MODE'] = 'bitcode'
          config.build_settings['ENABLE_BITCODE'] = 'YES'
        end

        # Enable strict warnings in debug
        if config.name == 'Debug'
          config.build_settings['SWIFT_TREAT_WARNINGS_AS_ERRORS'] = 'YES'
          config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'YES'
        end

        # Enable modern build system features
        config.build_settings['CLANG_ENABLE_OBJC_WEAK'] = 'YES'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'YES'
        
        # Deployment target settings
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      end
    end
  end
end
