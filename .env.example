# =============================================================================
# KINDRED APP CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# =============================================================================
# APP CONFIGURATION
# =============================================================================
APP_VERSION=1.0.0
BUILD_NUMBER=1
APP_DISPLAY_NAME=Kindred
ENVIRONMENT=development

# Platform-specific bundle identifiers
IOS_BUNDLE_ID=com.kindred.app
ANDROID_PACKAGE_NAME=com.kindred.app

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_BASE_URL=https://api.kindred.com
DEV_API_BASE_URL=http://localhost:3000
STAGING_API_BASE_URL=https://staging-api.kindred.com
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
ENABLE_API_MOCKING=false

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================================================================
# SOCIAL LOGIN CONFIGURATION
# =============================================================================
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
FACEBOOK_APP_ID=your_facebook_app_id
TWITTER_CONSUMER_KEY=your_twitter_consumer_key
TWITTER_CONSUMER_SECRET=your_twitter_consumer_secret

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
ENABLE_ANALYTICS=true
ANALYTICS_TRACKING_ID=your_analytics_tracking_id
ENABLE_CRASHLYTICS=true
ENABLE_PERFORMANCE_MONITORING=true
ANALYTICS_SAMPLE_RATE=1.0
SENTRY_DSN=your_sentry_dsn

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
ENABLE_BIOMETRICS=true
SESSION_TIMEOUT=1800000
MAX_LOGIN_ATTEMPTS=5
ENABLE_ENCRYPTION=true
ENABLE_CERT_PINNING=false

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
ENABLE_HERMES=true
ENABLE_FLIPPER=true
ENABLE_CODEPUSH=false
ENABLE_BUNDLE_SPLITTING=false
ENABLE_LAZY_LOADING=true

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_NEW_UI=false
FEATURE_OFFLINE_MODE=false
FEATURE_PUSH_NOTIFICATIONS=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_BIOMETRIC_AUTH=true
FEATURE_DARK_MODE=true
FEATURE_EXPERIMENTAL=false

# =============================================================================
# THIRD-PARTY SERVICES
# =============================================================================
CARBON_API_KEY=your_carbon_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_token
STRIPE_PUBLISHABLE_KEY=your_stripe_key

# =============================================================================
# CLIMATE DATA SERVICES (NEW)
# =============================================================================
# Climate TRACE API - Free, no key required
# 745M+ global emission sources
# Docs: https://api.climatetrace.org/swagger-ui/index.html
CLIMATE_TRACE_API_URL=https://api.climatetrace.org/v6

# ElectricityMaps API - Real-time grid carbon intensity
# Free tier: 100 requests/month, Paid: unlimited
# Sign up: https://api-portal.electricitymaps.com/
ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key

# WattTime API - Marginal emissions data (US focused)
# Free tier available, requires account
# Sign up: https://www.watttime.org/api-documentation/
WATTTIME_USERNAME=your_watttime_username
WATTTIME_PASSWORD=your_watttime_password

# OpenAQ API - Air quality data (free, open-source)
# Optional API key for higher rate limits
# Docs: https://docs.openaq.org/
OPENAQ_API_KEY=your_openaq_api_key

# IQAir API - Air quality data (backup)
# Free tier: 10,000 requests/month
# Sign up: https://www.iqair.com/air-pollution-data-api
IQAIR_API_KEY=your_iqair_api_key

# Our World in Data - Historical emissions (embedded, no key needed)
# Data source: https://github.com/owid/co2-data

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
ENABLE_DEV_MENU=true
ENABLE_REDUX_DEVTOOLS=true
ENABLE_REACT_DEVTOOLS=true
ENABLE_NETWORK_INSPECTOR=true
LOG_LEVEL=debug

# =============================================================================
# TESTING CONFIGURATION
# =============================================================================
ENABLE_E2E_TESTING=true
ENABLE_VISUAL_TESTING=false
ENABLE_ACCESSIBILITY_TESTING=true
TEST_TIMEOUT=30000

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
ENABLE_PROGUARD=true
ENABLE_MINIFICATION=true
ENABLE_SOURCE_MAPS=true
BUNDLE_ANALYZER=false

# =============================================================================
# KINDRED FEATURE KEYS (added 2026-02-23)
# =============================================================================

# Vegan Calculator — ad reward system (Google AdMob)
ADMOB_APP_ID=ca-app-pub-xxxxxxxxxxxxxxxx~xxxxxxxxxx
ADMOB_REWARDED_AD_UNIT_IOS=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx
ADMOB_REWARDED_AD_UNIT_ANDROID=ca-app-pub-xxxxxxxxxxxxxxxx/xxxxxxxxxx

# Tree-planting partner (carbon offset credits → real trees)
PLANT_TREES_API_KEY=your_plant_trees_api_key_here
PLANT_TREES_API_URL=https://api.plant-for-the-planet.org

# Climatiq — detailed emissions factors for analytics predictions
CLIMATIQ_API_KEY=your_climatiq_api_key_here
CLIMATIQ_BASE_URL=https://beta3.api.climatiq.io

# Google Maps — Local Impact Map screen (eco locations, routing)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# EV Charging — ChargePoint API (Local Impact Map)
CHARGEPOINT_API_KEY=your_chargepoint_api_key_here

# Stripe — carbon offset purchases in the marketplace
STRIPE_SECRET_KEY=sk_live_your_stripe_secret  # SERVER-SIDE ONLY, never ship in-app

# LaunchDarkly — remote feature flags (A/B testing new screens)
LAUNCHDARKLY_SDK_KEY=sdk-your-launchdarkly-key-here

# UI library feature flags (enable when packages are installed)
FEATURE_SKIA_DASHBOARD=false       # @shopify/react-native-skia Bio-Digital Twin
FEATURE_MOTI_ANIMATIONS=false      # moti declarative animations
FEATURE_RN_PAPER=false             # react-native-paper component library

# WebSocket — real-time social feed and community updates
WEBSOCKET_URL=wss://api.kindred.earth/ws

# Amplitude — product analytics for engagement funnels
AMPLITUDE_API_KEY=your_amplitude_api_key_here