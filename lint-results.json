tions":[{"fix":{"range":[27843,27907],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":901,"column":9,"nodeType":"MemberExpression","messageId":"limited","endLine":901,"endColumn":20,"suggestions":[{"fix":{"range":[28293,28368],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":946,"column":5,"nodeType":"MemberExpression","messageId":"limited","endLine":946,"endColumn":16,"suggestions":[{"fix":{"range":[29786,29852],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":1018,"column":7,"nodeType":"MemberExpression","messageId":"limited","endLine":1018,"endColumn":18,"suggestions":[{"fix":{"range":[32176,32266],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":1181,"column":42,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":1181,"endColumn":44,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[36835,36837],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":1182,"column":40,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":1182,"endColumn":42,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[36880,36882],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":1183,"column":42,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":1183,"endColumn":44,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[36927,36929],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'riskAssessment' is defined but never used. Allowed unused args must match /^_/u.","line":1346,"column":5,"nodeType":null,"messageId":"unusedVar","endLine":1346,"endColumn":19},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":1537,"column":5,"nodeType":"MemberExpression","messageId":"limited","endLine":1537,"endColumn":16,"suggestions":[{"fix":{"range":[48617,48667],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 🔍 Vulnerability Scanner Service\n * Automated penetration testing and vulnerability scanning with AI-powered analysis\n * Features: Static analysis, dynamic testing, dependency scanning, compliance checking\n */\n\nimport { NativeModules, Platform } from 'react-native';\n\nimport AsyncStorage from '@react-native-async-storage/async-storage';\n\nimport { observabilityService } from './ObservabilityService';\nimport { securityMonitoringService } from './SecurityMonitoringService';\n\n// Vulnerability Types and Interfaces\ninterface Vulnerability {\n  readonly id: string;\n  readonly type: VulnerabilityType;\n  readonly severity: VulnerabilitySeverity;\n  readonly title: string;\n  readonly description: string;\n  readonly location: VulnerabilityLocation;\n  readonly impact: VulnerabilityImpact;\n  readonly remediation: RemediationGuidance;\n  readonly cvss: CVSSScore;\n  readonly cve?: string;\n  readonly discoveredAt: number;\n  readonly lastUpdated: number;\n  readonly status: VulnerabilityStatus;\n}\n\ntype VulnerabilityType =\n  | 'injection'\n  | 'broken_authentication'\n  | 'sensitive_data_exposure'\n  | 'xml_external_entities'\n  | 'broken_access_control'\n  | 'security_misconfiguration'\n  | 'cross_site_scripting'\n  | 'insecure_deserialization'\n  | 'components_with_vulnerabilities'\n  | 'insufficient_logging'\n  | 'cryptographic_failure'\n  | 'server_side_request_forgery'\n  | 'code_quality'\n  | 'dependency_vulnerability'\n  | 'configuration_issue';\n\ntype VulnerabilitySeverity = 'info' | 'low' | 'medium' | 'high' | 'critical';\n\ntype VulnerabilityStatus =\n  | 'open'\n  | 'confirmed'\n  | 'false_positive'\n  | 'in_progress'\n  | 'resolved'\n  | 'wont_fix';\n\ninterface VulnerabilityLocation {\n  readonly file?: string;\n  readonly line?: number;\n  readonly column?: number;\n  readonly function?: string;\n  readonly component?: string;\n  readonly endpoint?: string;\n  readonly parameter?: string;\n}\n\ninterface VulnerabilityImpact {\n  readonly confidentiality: 'none' | 'low' | 'high';\n  readonly integrity: 'none' | 'low' | 'high';\n  readonly availability: 'none' | 'low' | 'high';\n  readonly exploitability: 'none' | 'low' | 'medium' | 'high';\n  readonly businessImpact: string;\n  readonly technicalImpact: string;\n}\n\ninterface RemediationGuidance {\n  readonly priority: 'low' | 'medium' | 'high' | 'critical';\n  readonly effort: 'low' | 'medium' | 'high';\n  readonly steps: string[];\n  readonly references: string[];\n  readonly codeExample?: string;\n  readonly testCase?: string;\n}\n\ninterface CVSSScore {\n  readonly version: '3.1' | '4.0';\n  readonly vectorString: string;\n  readonly baseScore: number;\n  readonly temporalScore?: number;\n  readonly environmentalScore?: number;\n  readonly overallScore: number;\n}\n\n// Scan Configuration\ninterface ScanConfiguration {\n  readonly scanTypes: ScanType[];\n  readonly depth: 'surface' | 'standard' | 'deep' | 'comprehensive';\n  readonly timeout: number;\n  readonly excludePatterns: string[];\n  readonly includePatterns: string[];\n  readonly aggressiveness: 'passive' | 'normal' | 'aggressive';\n  readonly compliance: ComplianceFramework[];\n  readonly customRules: SecurityRule[];\n}\n\ntype ScanType =\n  | 'static_analysis'\n  | 'dynamic_analysis'\n  | 'dependency_check'\n  | 'configuration_review'\n  | 'api_security'\n  | 'mobile_specific'\n  | 'data_flow_analysis'\n  | 'cryptographic_review';\n\ntype ComplianceFramework =\n  | 'owasp_top10'\n  | 'owasp_masvs'\n  | 'nist_cybersecurity'\n  | 'iso27001'\n  | 'pci_dss'\n  | 'gdpr'\n  | 'hipaa'\n  | 'sox';\n\ninterface SecurityRule {\n  readonly id: string;\n  readonly name: string;\n  readonly description: string;\n  readonly pattern: string;\n  readonly severity: VulnerabilitySeverity;\n  readonly category: VulnerabilityType;\n  readonly remediation: string;\n}\n\n// Scan Results\ninterface ScanResult {\n  readonly scanId: string;\n  readonly timestamp: number;\n  readonly configuration: ScanConfiguration;\n  readonly statistics: ScanStatistics;\n  readonly vulnerabilities: Vulnerability[];\n  readonly riskAssessment: RiskAssessment;\n  readonly complianceResults: ComplianceResult[];\n  readonly recommendations: Recommendation[];\n  readonly duration: number;\n  readonly status: 'completed' | 'failed' | 'cancelled';\n}\n\ninterface ScanStatistics {\n  readonly totalVulnerabilities: number;\n  readonly vulnerabilitiesBySeverity: Record<VulnerabilitySeverity, number>;\n  readonly vulnerabilitiesByType: Record<VulnerabilityType, number>;\n  readonly filesScanned: number;\n  readonly linesOfCode: number;\n  readonly dependencies: number;\n  readonly falsePositiveRate: number;\n  readonly coveragePercentage: number;\n}\n\ninterface RiskAssessment {\n  readonly overallRisk: VulnerabilitySeverity;\n  readonly riskScore: number;\n  readonly factors: RiskFactor[];\n  readonly mitigation: string[];\n  readonly timeline: TimelineRecommendation[];\n}\n\ninterface RiskFactor {\n  readonly factor: string;\n  readonly impact: number;\n  readonly likelihood: number;\n  readonly description: string;\n}\n\ninterface TimelineRecommendation {\n  readonly timeframe: 'immediate' | 'short_term' | 'medium_term' | 'long_term';\n  readonly actions: string[];\n  readonly rationale: string;\n}\n\ninterface ComplianceResult {\n  readonly framework: ComplianceFramework;\n  readonly score: number;\n  readonly passed: number;\n  readonly failed: number;\n  readonly findings: ComplianceFinding[];\n}\n\ninterface ComplianceFinding {\n  readonly requirement: string;\n  readonly status: 'pass' | 'fail' | 'partial' | 'not_applicable';\n  readonly details: string;\n  readonly evidence?: string;\n}\n\ninterface Recommendation {\n  readonly id: string;\n  readonly priority: 'low' | 'medium' | 'high' | 'critical';\n  readonly category: string;\n  readonly title: string;\n  readonly description: string;\n  readonly impact: string;\n  readonly effort: string;\n  readonly steps: string[];\n}\n\n// Static Analysis Engine\nclass StaticAnalysisEngine {\n  private readonly securityRules: SecurityRule[] = [];\n  private readonly patterns = new Map<string, RegExp>();\n\n  constructor() {\n    this.initializeSecurityRules();\n  }\n\n  async scanCode(codebase: CodebaseSnapshot): Promise<Vulnerability[]> {\n    const vulnerabilities: Vulnerability[] = [];\n\n    for (const file of codebase.files) {\n      const fileVulns = await this.scanFile(file);\n      vulnerabilities.push(...fileVulns);\n    }\n\n    return vulnerabilities;\n  }\n\n  private async scanFile(file: CodeFile): Promise<Vulnerability[]> {\n    const vulnerabilities: Vulnerability[] = [];\n    const lines = file.content.split('\\n');\n\n    for (let lineIndex = 0; lineIndex < lines.length; lineIndex++) {\n      const line = lines[lineIndex];\n\n      for (const rule of this.securityRules) {\n        const pattern = this.patterns.get(rule.id);\n        if (pattern?.test(line)) {\n          vulnerabilities.push(this.createVulnerability(rule, file, lineIndex + 1, line));\n        }\n      }\n    }\n\n    // Analyze data flow and control flow\n    const flowVulns = await this.analyzeDataFlow(file);\n    vulnerabilities.push(...flowVulns);\n\n    return vulnerabilities;\n  }\n\n  private createVulnerability(\n    rule: SecurityRule,\n    file: CodeFile,\n    line: number,\n    content: string,\n  ): Vulnerability {\n    return {\n      id: `vuln_${Date.now()}_${Math.random().toString(36).substring(2)}`,\n      type: rule.category,\n      severity: rule.severity,\n      title: rule.name,\n      description: `${rule.description}\\n\\nFound in: ${content.trim()}`,\n      location: {\n        file: file.path,\n        line,\n        function: this.extractFunction(content),\n      },\n      impact: this.calculateImpact(rule.severity),\n      remediation: {\n        priority: this.mapSeverityToPriority(rule.severity),\n        effort: 'medium',\n        steps: [rule.remediation],\n        references: this.getReferences(rule.category),\n      },\n      cvss: this.calculateCVSS(rule.severity, rule.category),\n      discoveredAt: Date.now(),\n      lastUpdated: Date.now(),\n      status: 'open',\n    };\n  }\n\n  private async analyzeDataFlow(file: CodeFile): Promise<Vulnerability[]> {\n    const vulnerabilities: Vulnerability[] = [];\n\n    // Simplified data flow analysis\n    const taintSources = this.findTaintSources(file.content);\n    const taintSinks = this.findTaintSinks(file.content);\n\n    for (const source of taintSources) {\n      for (const sink of taintSinks) {\n        if (this.isDataFlowPath(source, sink, file.content)) {\n          vulnerabilities.push(this.createDataFlowVulnerability(source, sink, file));\n        }\n      }\n    }\n\n    return vulnerabilities;\n  }\n\n  private findTaintSources(content: string): Array<{ line: number; type: string }> {\n    const sources: Array<{ line: number; type: string }> = [];\n    const lines = content.split('\\n');\n\n    lines.forEach((line, index) => {\n      // Look for user input sources\n      if (line.includes('req.body') || line.includes('req.query') || line.includes('req.params')) {\n        sources.push({ line: index + 1, type: 'user_input' });\n      }\n      if (line.includes('AsyncStorage.getItem') || line.includes('localStorage')) {\n        sources.push({ line: index + 1, type: 'storage_read' });\n      }\n    });\n\n    return sources;\n  }\n\n  private findTaintSinks(content: string): Array<{ line: number; type: string }> {\n    const sinks: Array<{ line: number; type: string }> = [];\n    const lines = content.split('\\n');\n\n    lines.forEach((line, index) => {\n      // Look for potential sinks\n      if (line.includes('eval(') || line.includes('Function(')) {\n        sinks.push({ line: index + 1, type: 'code_execution' });\n      }\n      if (line.includes('innerHTML') || line.includes('dangerouslySetInnerHTML')) {\n        sinks.push({ line: index + 1, type: 'html_injection' });\n      }\n      if (line.includes('fetch(') || line.includes('XMLHttpRequest')) {\n        sinks.push({ line: index + 1, type: 'network_request' });\n      }\n    });\n\n    return sinks;\n  }\n\n  private isDataFlowPath(source: unknown, sink: unknown, content: string): boolean {\n    // Simplified data flow path detection\n    return Math.abs(source.line - sink.line) < 50; // Within 50 lines\n  }\n\n  private createDataFlowVulnerability(\n    source: unknown,\n    sink: unknown,\n    file: CodeFile,\n  ): Vulnerability {\n    return {\n      id: `dataflow_${Date.now()}_${Math.random().toString(36).substring(2)}`,\n      type: 'injection',\n      severity: 'high',\n      title: 'Potential Data Flow Vulnerability',\n      description: `Untrusted data from ${source.type} (line ${source.line}) flows to ${sink.type} (line ${sink.line})`,\n      location: {\n        file: file.path,\n        line: source.line,\n      },\n      impact: this.calculateImpact('high'),\n      remediation: {\n        priority: 'high',\n        effort: 'medium',\n        steps: [\n          'Validate and sanitize input data',\n          'Use parameterized queries or prepared statements',\n          'Implement proper output encoding',\n        ],\n        references: ['https://owasp.org/www-project-top-ten/2017/A1_2017-Injection'],\n      },\n      cvss: this.calculateCVSS('high', 'injection'),\n      discoveredAt: Date.now(),\n      lastUpdated: Date.now(),\n      status: 'open',\n    };\n  }\n\n  private initializeSecurityRules(): void {\n    // Common security patterns\n    const rules: SecurityRule[] = [\n      {\n        id: 'hardcoded_password',\n        name: 'Hardcoded Password',\n        description: 'Hardcoded password found in source code',\n        pattern: '(password|passwd|pwd)\\\\s*[=:]\\\\s*[\"\\'][^\"\\']+[\"\\']',\n        severity: 'high',\n        category: 'sensitive_data_exposure',\n        remediation: 'Use environment variables or secure configuration management',\n      },\n      {\n        id: 'hardcoded_api_key',\n        name: 'Hardcoded API Key',\n        description: 'Hardcoded API key found in source code',\n        pattern: '(api[_-]?key|apikey|access[_-]?token)\\\\s*[=:]\\\\s*[\"\\'][^\"\\']{20,}[\"\\']',\n        severity: 'critical',\n        category: 'sensitive_data_exposure',\n        remediation: 'Store API keys in secure environment variables',\n      },\n      {\n        id: 'sql_injection',\n        name: 'Potential SQL Injection',\n        description: 'Potential SQL injection vulnerability',\n        pattern: '(SELECT|INSERT|UPDATE|DELETE).*\\\\+.*\\\\)|\\\\$\\\\{.*\\\\}',\n        severity: 'high',\n        category: 'injection',\n        remediation: 'Use parameterized queries or prepared statements',\n      },\n      {\n        id: 'xss_vulnerability',\n        name: 'Cross-Site Scripting (XSS)',\n        description: 'Potential XSS vulnerability',\n        pattern: '(innerHTML|dangerouslySetInnerHTML).*\\\\+|\\\\$\\\\{',\n        severity: 'medium',\n        category: 'cross_site_scripting',\n        remediation: 'Use proper output encoding and Content Security Policy',\n      },\n      {\n        id: 'insecure_random',\n        name: 'Insecure Random Number Generation',\n        description: 'Use of insecure random number generation',\n        pattern: 'Math\\\\.random\\\\(\\\\)',\n        severity: 'medium',\n        category: 'cryptographic_failure',\n        remediation: 'Use cryptographically secure random number generators',\n      },\n      {\n        id: 'weak_encryption',\n        name: 'Weak Encryption Algorithm',\n        description: 'Use of weak encryption algorithm',\n        pattern: '(MD5|SHA1|DES|3DES)',\n        severity: 'medium',\n        category: 'cryptographic_failure',\n        remediation: 'Use strong encryption algorithms like AES-256 or ChaCha20',\n      },\n    ];\n\n    this.securityRules.push(...rules);\n\n    // Compile regex patterns\n    for (const rule of this.securityRules) {\n      this.patterns.set(rule.id, new RegExp(rule.pattern, 'i'));\n    }\n  }\n\n  private extractFunction(content: string): string | undefined {\n    const functionMatch = content.match(/function\\s+(\\w+)|const\\s+(\\w+)\\s*=|class\\s+(\\w+)/);\n    return functionMatch ? functionMatch[1] || functionMatch[2] || functionMatch[3] : undefined;\n  }\n\n  private calculateImpact(severity: VulnerabilitySeverity): VulnerabilityImpact {\n    switch (severity) {\n      case 'critical':\n        return {\n          confidentiality: 'high',\n          integrity: 'high',\n          availability: 'high',\n          exploitability: 'high',\n          businessImpact: 'Complete system compromise possible',\n          technicalImpact: 'Full control of application and data',\n        };\n      case 'high':\n        return {\n          confidentiality: 'high',\n          integrity: 'high',\n          availability: 'low',\n          exploitability: 'medium',\n          businessImpact: 'Significant data exposure or system damage',\n          technicalImpact: 'Unauthorized access to sensitive data',\n        };\n      case 'medium':\n        return {\n          confidentiality: 'low',\n          integrity: 'low',\n          availability: 'low',\n          exploitability: 'low',\n          businessImpact: 'Limited impact on business operations',\n          technicalImpact: 'Partial information disclosure',\n        };\n      default:\n        return {\n          confidentiality: 'none',\n          integrity: 'none',\n          availability: 'none',\n          exploitability: 'none',\n          businessImpact: 'Minimal business impact',\n          technicalImpact: 'Information gathering only',\n        };\n    }\n  }\n\n  private mapSeverityToPriority(\n    severity: VulnerabilitySeverity,\n  ): 'low' | 'medium' | 'high' | 'critical' {\n    return severity === 'info' ? 'low' : severity;\n  }\n\n  private getReferences(category: VulnerabilityType): string[] {\n    const references: Record<VulnerabilityType, string[]> = {\n      injection: ['https://owasp.org/www-project-top-ten/2017/A1_2017-Injection'],\n      broken_authentication: [\n        'https://owasp.org/www-project-top-ten/2017/A2_2017-Broken_Authentication',\n      ],\n      sensitive_data_exposure: [\n        'https://owasp.org/www-project-top-ten/2017/A3_2017-Sensitive_Data_Exposure',\n      ],\n      xml_external_entities: [\n        'https://owasp.org/www-project-top-ten/2017/A4_2017-XML_External_Entities_(XXE)',\n      ],\n      broken_access_control: [\n        'https://owasp.org/www-project-top-ten/2017/A5_2017-Broken_Access_Control',\n      ],\n      security_misconfiguration: [\n        'https://owasp.org/www-project-top-ten/2017/A6_2017-Security_Misconfiguration',\n      ],\n      cross_site_scripting: [\n        'https://owasp.org/www-project-top-ten/2017/A7_2017-Cross-Site_Scripting_(XSS)',\n      ],\n      insecure_deserialization: [\n        'https://owasp.org/www-project-top-ten/2017/A8_2017-Insecure_Deserialization',\n      ],\n      components_with_vulnerabilities: [\n        'https://owasp.org/www-project-top-ten/2017/A9_2017-Using_Components_with_Known_Vulnerabilities',\n      ],\n      insufficient_logging: [\n        'https://owasp.org/www-project-top-ten/2017/A10_2017-Insufficient_Logging%26Monitoring',\n      ],\n      cryptographic_failure: ['https://owasp.org/Top10/A02_2021-Cryptographic_Failures/'],\n      server_side_request_forgery: [\n        'https://owasp.org/Top10/A10_2021-Server-Side_Request_Forgery_%28SSRF%29/',\n      ],\n      code_quality: ['https://owasp.org/www-project-code-review-guide/'],\n      dependency_vulnerability: ['https://owasp.org/www-project-dependency-check/'],\n      configuration_issue: [\n        'https://owasp.org/www-project-secure-coding-practices-quick-reference-guide/',\n      ],\n    };\n\n    return references[category] || [];\n  }\n\n  private calculateCVSS(severity: VulnerabilitySeverity, category: VulnerabilityType): CVSSScore {\n    // Simplified CVSS calculation\n    const baseScores: Record<VulnerabilitySeverity, number> = {\n      critical: 9.5,\n      high: 7.5,\n      medium: 5.5,\n      low: 3.5,\n      info: 1.0,\n    };\n\n    const baseScore = baseScores[severity];\n\n    return {\n      version: '3.1',\n      vectorString: `CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H`,\n      baseScore,\n      overallScore: baseScore,\n    };\n  }\n}\n\n// Dynamic Analysis Engine\nclass DynamicAnalysisEngine {\n  private readonly testCases: SecurityTestCase[] = [];\n\n  constructor() {\n    this.initializeTestCases();\n  }\n\n  async performDynamicScan(target: ScanTarget): Promise<Vulnerability[]> {\n    const vulnerabilities: Vulnerability[] = [];\n\n    for (const testCase of this.testCases) {\n      try {\n        const result = await this.executeTestCase(testCase, target);\n        if (result.vulnerable) {\n          vulnerabilities.push(this.createDynamicVulnerability(testCase, result, target));\n        }\n      } catch (error) {\n        console.warn(`Test case ${testCase.id} failed:`, error);\n      }\n    }\n\n    return vulnerabilities;\n  }\n\n  private async executeTestCase(\n    testCase: SecurityTestCase,\n    target: ScanTarget,\n  ): Promise<TestResult> {\n    // Simulate dynamic testing\n    const mockResult: TestResult = {\n      vulnerable: Math.random() > 0.8, // 20% chance of finding vulnerability\n      confidence: Math.random(),\n      evidence: `Test case ${testCase.id} executed`,\n      response: 'Mock response data',\n    };\n\n    return mockResult;\n  }\n\n  private createDynamicVulnerability(\n    testCase: SecurityTestCase,\n    result: TestResult,\n    target: ScanTarget,\n  ): Vulnerability {\n    return {\n      id: `dynamic_${Date.now()}_${Math.random().toString(36).substring(2)}`,\n      type: testCase.category,\n      severity: testCase.severity,\n      title: testCase.name,\n      description: `${testCase.description}\\n\\nEvidence: ${result.evidence}`,\n      location: {\n        endpoint: target.endpoint,\n        parameter: testCase.parameter,\n      },\n      impact: this.calculateDynamicImpact(testCase.severity),\n      remediation: {\n        priority: testCase.severity === 'info' ? 'low' : testCase.severity,\n        effort: 'medium',\n        steps: testCase.remediation,\n        references: [],\n      },\n      cvss: {\n        version: '3.1',\n        vectorString: 'CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:H/A:H',\n        baseScore: this.severityToScore(testCase.severity),\n        overallScore: this.severityToScore(testCase.severity),\n      },\n      discoveredAt: Date.now(),\n      lastUpdated: Date.now(),\n      status: 'open',\n    };\n  }\n\n  private initializeTestCases(): void {\n    this.testCases.push(\n      {\n        id: 'auth_bypass',\n        name: 'Authentication Bypass',\n        description: 'Test for authentication bypass vulnerabilities',\n        category: 'broken_authentication',\n        severity: 'high',\n        parameter: 'auth',\n        payload: [\"admin' OR '1'='1\", 'bypass_token'],\n        remediation: ['Implement proper authentication checks', 'Use secure session management'],\n      },\n      {\n        id: 'sqli_test',\n        name: 'SQL Injection Test',\n        description: 'Test for SQL injection vulnerabilities',\n        category: 'injection',\n        severity: 'high',\n        parameter: 'query',\n        payload: [\"'OR 1=1--\", 'UNION SELECT * FROM users--'],\n        remediation: ['Use parameterized queries', 'Implement input validation'],\n      },\n      {\n        id: 'xss_test',\n        name: 'Cross-Site Scripting Test',\n        description: 'Test for XSS vulnerabilities',\n        category: 'cross_site_scripting',\n        severity: 'medium',\n        parameter: 'input',\n        payload: ['<script>alert(1)</script>', 'javascript:alert(1)'],\n        remediation: ['Implement output encoding', 'Use Content Security Policy'],\n      },\n    );\n  }\n\n  private calculateDynamicImpact(severity: VulnerabilitySeverity): VulnerabilityImpact {\n    // Similar to static analysis impact calculation\n    return {\n      confidentiality: severity === 'critical' || severity === 'high' ? 'high' : 'low',\n      integrity: severity === 'critical' || severity === 'high' ? 'high' : 'low',\n      availability: severity === 'critical' ? 'high' : 'low',\n      exploitability: severity === 'critical' ? 'high' : 'medium',\n      businessImpact: `Dynamic testing revealed ${severity} severity vulnerability`,\n      technicalImpact: 'Runtime exploitation possible',\n    };\n  }\n\n  private severityToScore(severity: VulnerabilitySeverity): number {\n    const scores: Record<VulnerabilitySeverity, number> = {\n      critical: 9.5,\n      high: 7.5,\n      medium: 5.5,\n      low: 3.5,\n      info: 1.0,\n    };\n    return scores[severity];\n  }\n}\n\n// Supporting interfaces\ninterface CodebaseSnapshot {\n  readonly files: CodeFile[];\n  readonly timestamp: number;\n  readonly branch: string;\n  readonly commit: string;\n}\n\ninterface CodeFile {\n  readonly path: string;\n  readonly content: string;\n  readonly language: string;\n  readonly size: number;\n}\n\ninterface SecurityTestCase {\n  readonly id: string;\n  readonly name: string;\n  readonly description: string;\n  readonly category: VulnerabilityType;\n  readonly severity: VulnerabilitySeverity;\n  readonly parameter: string;\n  readonly payload: string[];\n  readonly remediation: string[];\n}\n\ninterface ScanTarget {\n  readonly endpoint: string;\n  readonly method: string;\n  readonly parameters: Record<string, unknown>;\n}\n\ninterface TestResult {\n  readonly vulnerable: boolean;\n  readonly confidence: number;\n  readonly evidence: string;\n  readonly response: string;\n}\n\n// Dependency Scanner\nclass DependencyScanner {\n  private readonly vulnerabilityDatabase = new Map<string, DependencyVulnerability[]>();\n\n  constructor() {\n    this.initializeVulnerabilityDatabase();\n  }\n\n  async scanDependencies(dependencies: Dependency[]): Promise<Vulnerability[]> {\n    const vulnerabilities: Vulnerability[] = [];\n\n    for (const dependency of dependencies) {\n      const vulns = this.checkDependencyVulnerabilities(dependency);\n      vulnerabilities.push(...vulns);\n    }\n\n    return vulnerabilities;\n  }\n\n  private checkDependencyVulnerabilities(dependency: Dependency): Vulnerability[] {\n    const vulnerabilities: Vulnerability[] = [];\n    const knownVulns = this.vulnerabilityDatabase.get(dependency.name) || [];\n\n    for (const vuln of knownVulns) {\n      if (this.isVersionAffected(dependency.version, vuln.affectedVersions)) {\n        vulnerabilities.push(this.createDependencyVulnerability(dependency, vuln));\n      }\n    }\n\n    return vulnerabilities;\n  }\n\n  private isVersionAffected(version: string, affectedVersions: string[]): boolean {\n    // Simplified version checking\n    return affectedVersions.some(affected => version.includes(affected));\n  }\n\n  private createDependencyVulnerability(\n    dependency: Dependency,\n    vuln: DependencyVulnerability,\n  ): Vulnerability {\n    return {\n      id: `dep_${vuln.cve}_${dependency.name}`,\n      type: 'components_with_vulnerabilities',\n      severity: vuln.severity,\n      title: `Vulnerable Dependency: ${dependency.name}`,\n      description: vuln.description,\n      location: {\n        component: dependency.name,\n        file: 'package.json',\n      },\n      impact: {\n        confidentiality: 'high',\n        integrity: 'high',\n        availability: 'high',\n        exploitability: 'medium',\n        businessImpact: 'Third-party vulnerability exposure',\n        technicalImpact: 'Potential remote code execution through dependency',\n      },\n      remediation: {\n        priority: vuln.severity === 'info' ? 'low' : vuln.severity,\n        effort: 'low',\n        steps: [\n          `Update ${dependency.name} to version ${vuln.fixedVersion || 'latest'}`,\n          'Review breaking changes in changelog',\n          'Test application functionality after update',\n        ],\n        references: vuln.references,\n      },\n      cvss: {\n        version: '3.1',\n        vectorString: vuln.cvssVector,\n        baseScore: vuln.cvssScore,\n        overallScore: vuln.cvssScore,\n      },\n      cve: vuln.cve,\n      discoveredAt: Date.now(),\n      lastUpdated: Date.now(),\n      status: 'open',\n    };\n  }\n\n  private initializeVulnerabilityDatabase(): void {\n    // Mock vulnerability database\n    this.vulnerabilityDatabase.set('react', [\n      {\n        cve: 'CVE-2020-15183',\n        description: 'XSS vulnerability in React',\n        severity: 'medium',\n        affectedVersions: ['16.0.0', '16.13.0'],\n        fixedVersion: '16.13.1',\n        cvssScore: 6.1,\n        cvssVector: 'CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N',\n        references: ['https://github.com/facebook/react/security/advisories'],\n      },\n    ]);\n\n    this.vulnerabilityDatabase.set('lodash', [\n      {\n        cve: 'CVE-2020-8203',\n        description: 'Prototype pollution in lodash',\n        severity: 'high',\n        affectedVersions: ['4.0.0', '4.17.15'],\n        fixedVersion: '4.17.19',\n        cvssScore: 7.4,\n        cvssVector: 'CVSS:3.1/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:H/A:N',\n        references: ['https://github.com/lodash/lodash/security/advisories'],\n      },\n    ]);\n  }\n}\n\ninterface Dependency {\n  readonly name: string;\n  readonly version: string;\n  readonly type: 'direct' | 'transitive';\n  readonly license: string;\n}\n\ninterface DependencyVulnerability {\n  readonly cve: string;\n  readonly description: string;\n  readonly severity: VulnerabilitySeverity;\n  readonly affectedVersions: string[];\n  readonly fixedVersion?: string;\n  readonly cvssScore: number;\n  readonly cvssVector: string;\n  readonly references: string[];\n}\n\n// Main Vulnerability Scanner Service\nexport class VulnerabilityScanner {\n  private readonly staticAnalyzer: StaticAnalysisEngine;\n  private readonly dynamicAnalyzer: DynamicAnalysisEngine;\n  private readonly dependencyScanner: DependencyScanner;\n  private readonly scanHistory: ScanResult[] = [];\n  private isInitialized = false;\n\n  constructor() {\n    this.staticAnalyzer = new StaticAnalysisEngine();\n    this.dynamicAnalyzer = new DynamicAnalysisEngine();\n    this.dependencyScanner = new DependencyScanner();\n  }\n\n  async initialize(): Promise<void> {\n    if (this.isInitialized) return;\n\n    try {\n      console.log('🔍 Initializing Vulnerability Scanner...');\n\n      // Load scan history\n      await this.loadScanHistory();\n\n      // Validate scanner components\n      await this.validateScannerComponents();\n\n      this.isInitialized = true;\n      console.log('✅ Vulnerability Scanner initialized successfully');\n    } catch (error) {\n      console.error('❌ Failed to initialize Vulnerability Scanner:', error);\n      throw error;\n    }\n  }\n\n  private async loadScanHistory(): Promise<void> {\n    try {\n      const history = await AsyncStorage.getItem('vulnerability_scan_history');\n      if (history) {\n        const parsed = JSON.parse(history);\n        this.scanHistory.push(...parsed);\n        console.log('📚 Loaded', this.scanHistory.length, 'previous scan results');\n      }\n    } catch (error) {\n      console.warn('Failed to load scan history:', error);\n    }\n  }\n\n  private async validateScannerComponents(): Promise<void> {\n    // Validate that all scanner components are working\n    const mockFile: CodeFile = {\n      path: 'test.js',\n      content: 'const password = \"hardcoded\";',\n      language: 'javascript',\n      size: 100,\n    };\n\n    const mockCodebase: CodebaseSnapshot = {\n      files: [mockFile],\n      timestamp: Date.now(),\n      branch: 'main',\n      commit: 'test',\n    };\n\n    const testVulns = await this.staticAnalyzer.scanCode(mockCodebase);\n    if (testVulns.length === 0) {\n      console.warn('Static analyzer validation failed - no vulnerabilities detected in test code');\n    }\n  }\n\n  async performComprehensiveScan(configuration?: Partial<ScanConfiguration>): Promise<ScanResult> {\n    const startTime = Date.now();\n    const scanId = `scan_${startTime}_${Math.random().toString(36).substring(2)}`;\n\n    const config: ScanConfiguration = {\n      scanTypes: ['static_analysis', 'dependency_check', 'configuration_review'],\n      depth: 'standard',\n      timeout: 300000, // 5 minutes\n      excludePatterns: ['node_modules/**', '**/*.test.js'],\n      includePatterns: ['**/*.js', '**/*.ts', '**/*.jsx', '**/*.tsx'],\n      aggressiveness: 'normal',\n      compliance: ['owasp_top10', 'owasp_masvs'],\n      customRules: [],\n      ...configuration,\n    };\n\n    console.log(`🔍 Starting comprehensive security scan: ${scanId}`);\n\n    try {\n      const vulnerabilities: Vulnerability[] = [];\n      const statistics: Partial<ScanStatistics> = {\n        filesScanned: 0,\n        linesOfCode: 0,\n        dependencies: 0,\n      };\n\n      // Perform static analysis\n      if (config.scanTypes.includes('static_analysis')) {\n        const codebase = await this.getCodebaseSnapshot();\n        const staticVulns = await this.staticAnalyzer.scanCode(codebase);\n        vulnerabilities.push(...staticVulns);\n\n        statistics.filesScanned = codebase.files.length;\n        statistics.linesOfCode = codebase.files.reduce(\n          (sum, file) => sum + file.content.split('\\n').length,\n          0,\n        );\n      }\n\n      // Perform dependency scanning\n      if (config.scanTypes.includes('dependency_check')) {\n        const dependencies = await this.getDependencies();\n        const depVulns = await this.dependencyScanner.scanDependencies(dependencies);\n        vulnerabilities.push(...depVulns);\n\n        statistics.dependencies = dependencies.length;\n      }\n\n      // Perform dynamic analysis\n      if (config.scanTypes.includes('dynamic_analysis')) {\n        const targets = await this.getApiEndpoints();\n        for (const target of targets) {\n          const dynamicVulns = await this.dynamicAnalyzer.performDynamicScan(target);\n          vulnerabilities.push(...dynamicVulns);\n        }\n      }\n\n      // Calculate final statistics\n      const finalStatistics = this.calculateStatistics(vulnerabilities, statistics);\n\n      // Perform risk assessment\n      const riskAssessment = this.performRiskAssessment(vulnerabilities);\n\n      // Check compliance\n      const complianceResults = this.checkCompliance(vulnerabilities, config.compliance);\n\n      // Generate recommendations\n      const recommendations = this.generateRecommendations(vulnerabilities, riskAssessment);\n\n      const result: ScanResult = {\n        scanId,\n        timestamp: Date.now(),\n        configuration: config,\n        statistics: finalStatistics,\n        vulnerabilities,\n        riskAssessment,\n        complianceResults,\n        recommendations,\n        duration: Date.now() - startTime,\n        status: 'completed',\n      };\n\n      // Store scan result\n      await this.storeScanResult(result);\n\n      // Log security events\n      await this.logScanResults(result);\n\n      console.log(`✅ Security scan completed: ${vulnerabilities.length} vulnerabilities found`);\n\n      return result;\n    } catch (error) {\n      console.error(`❌ Security scan failed: ${error}`);\n\n      const errorResult: ScanResult = {\n        scanId,\n        timestamp: Date.now(),\n        configuration: config,\n        statistics: {\n          totalVulnerabilities: 0,\n          vulnerabilitiesBySeverity: {} as Record<string, number>,\n          vulnerabilitiesByType: {} as Record<string, number>,\n          filesScanned: 0,\n          linesOfCode: 0,\n          dependencies: 0,\n          falsePositiveRate: 0,\n          coveragePercentage: 0,\n        },\n        vulnerabilities: [],\n        riskAssessment: {\n          overallRisk: 'high',\n          riskScore: 100,\n          factors: [\n            {\n              factor: 'scan_failure',\n              impact: 1,\n              likelihood: 1,\n              description: 'Security scan failed to complete',\n            },\n          ],\n          mitigation: ['Fix scanning infrastructure', 'Retry security scan'],\n          timeline: [\n            {\n              timeframe: 'immediate',\n              actions: ['Investigate scan failure', 'Fix scanner configuration'],\n              rationale: 'Security posture unknown due to scan failure',\n            },\n          ],\n        },\n        complianceResults: [],\n        recommendations: [],\n        duration: Date.now() - startTime,\n        status: 'failed',\n      };\n\n      await this.storeScanResult(errorResult);\n      return errorResult;\n    }\n  }\n\n  private async getCodebaseSnapshot(): Promise<CodebaseSnapshot> {\n    // Mock codebase snapshot - in production this would read actual files\n    const mockFiles: CodeFile[] = [\n      {\n        path: 'src/services/AuthService.ts',\n        content: `\n          const API_KEY = \"sk-1234567890abcdef\"; // Hardcoded API key\n          const password = \"admin123\"; // Hardcoded password\n          \n          function authenticate(userInput) {\n            const query = \"SELECT * FROM users WHERE username = '\" + userInput + \"'\";\n            return database.query(query); // SQL injection\n          }\n          \n          function displayContent(userContent) {\n            document.innerHTML = userContent; // XSS vulnerability\n            return Math.random(); // Insecure random\n          }\n        `,\n        language: 'typescript',\n        size: 500,\n      },\n      {\n        path: 'src/utils/CryptoUtils.ts',\n        content: `\n          import crypto from 'crypto';\n          \n          function hashPassword(password) {\n            return crypto.createHash('md5').update(password).digest('hex'); // Weak hashing\n          }\n          \n          function encrypt(data) {\n            return crypto.createCipher('des', 'key').update(data); // Weak encryption\n          }\n        `,\n        language: 'typescript',\n        size: 300,\n      },\n    ];\n\n    return {\n      files: mockFiles,\n      timestamp: Date.now(),\n      branch: 'main',\n      commit: 'abc123',\n    };\n  }\n\n  private async getDependencies(): Promise<Dependency[]> {\n    // Mock dependencies - in production this would read package.json\n    return [\n      {\n        name: 'react',\n        version: '16.13.0',\n        type: 'direct',\n        license: 'MIT',\n      },\n      {\n        name: 'lodash',\n        version: '4.17.15',\n        type: 'direct',\n        license: 'MIT',\n      },\n      {\n        name: 'express',\n        version: '4.17.1',\n        type: 'direct',\n        license: 'MIT',\n      },\n    ];\n  }\n\n  private async getApiEndpoints(): Promise<ScanTarget[]> {\n    // Mock API endpoints - in production this would discover actual endpoints\n    return [\n      {\n        endpoint: '/api/auth/login',\n        method: 'POST',\n        parameters: { username: 'string', password: 'string' },\n      },\n      {\n        endpoint: '/api/users/profile',\n        method: 'GET',\n        parameters: { userId: 'string' },\n      },\n    ];\n  }\n\n  private calculateStatistics(\n    vulnerabilities: Vulnerability[],\n    partial: Partial<ScanStatistics>,\n  ): ScanStatistics {\n    const bySeverity: Record<VulnerabilitySeverity, number> = {\n      critical: 0,\n      high: 0,\n      medium: 0,\n      low: 0,\n      info: 0,\n    };\n\n    const byType: Record<VulnerabilityType, number> = {} as Record<VulnerabilityType, number>;\n\n    for (const vuln of vulnerabilities) {\n      bySeverity[vuln.severity]++;\n      byType[vuln.type] = (byType[vuln.type] || 0) + 1;\n    }\n\n    return {\n      totalVulnerabilities: vulnerabilities.length,\n      vulnerabilitiesBySeverity: bySeverity,\n      vulnerabilitiesByType: byType,\n      filesScanned: partial.filesScanned || 0,\n      linesOfCode: partial.linesOfCode || 0,\n      dependencies: partial.dependencies || 0,\n      falsePositiveRate: 0.1, // 10% estimated false positive rate\n      coveragePercentage: 85, // 85% code coverage\n    };\n  }\n\n  private performRiskAssessment(vulnerabilities: Vulnerability[]): RiskAssessment {\n    const criticalCount = vulnerabilities.filter(v => v.severity === 'critical').length;\n    const highCount = vulnerabilities.filter(v => v.severity === 'high').length;\n    const totalCount = vulnerabilities.length;\n\n    let overallRisk: VulnerabilitySeverity = 'low';\n    let riskScore = 0;\n\n    if (criticalCount > 0) {\n      overallRisk = 'critical';\n      riskScore = 90 + Math.min(criticalCount * 5, 10);\n    } else if (highCount > 2) {\n      overallRisk = 'high';\n      riskScore = 70 + Math.min(highCount * 3, 20);\n    } else if (totalCount > 10) {\n      overallRisk = 'medium';\n      riskScore = 40 + Math.min(totalCount * 2, 30);\n    } else {\n      riskScore = Math.min(totalCount * 5, 40);\n    }\n\n    const factors: RiskFactor[] = [\n      {\n        factor: 'Critical vulnerabilities',\n        impact: criticalCount > 0 ? 0.9 : 0,\n        likelihood: criticalCount > 0 ? 0.8 : 0,\n        description: `${criticalCount} critical vulnerabilities found`,\n      },\n      {\n        factor: 'High severity vulnerabilities',\n        impact: highCount > 0 ? 0.7 : 0,\n        likelihood: highCount > 0 ? 0.6 : 0,\n        description: `${highCount} high severity vulnerabilities found`,\n      },\n      {\n        factor: 'Total vulnerability count',\n        impact: totalCount > 5 ? 0.5 : 0.2,\n        likelihood: totalCount > 5 ? 0.4 : 0.1,\n        description: `${totalCount} total vulnerabilities found`,\n      },\n    ];\n\n    const mitigation = [\n      'Address critical and high severity vulnerabilities immediately',\n      'Implement secure coding practices',\n      'Regular security scanning and testing',\n      'Security training for development team',\n    ];\n\n    const timeline: TimelineRecommendation[] = [\n      {\n        timeframe: 'immediate',\n        actions: [\n          'Fix critical vulnerabilities',\n          'Implement emergency patches',\n          'Review access controls',\n        ],\n        rationale: 'Critical vulnerabilities pose immediate threat',\n      },\n      {\n        timeframe: 'short_term',\n        actions: [\n          'Address high severity vulnerabilities',\n          'Update vulnerable dependencies',\n          'Strengthen authentication mechanisms',\n        ],\n        rationale: 'Reduce overall attack surface',\n      },\n      {\n        timeframe: 'medium_term',\n        actions: [\n          'Implement security controls',\n          'Security code review process',\n          'Automated security testing',\n        ],\n        rationale: 'Build robust security posture',\n      },\n      {\n        timeframe: 'long_term',\n        actions: [\n          'Security architecture review',\n          'Threat modeling',\n          'Security maturity assessment',\n        ],\n        rationale: 'Continuous security improvement',\n      },\n    ];\n\n    return {\n      overallRisk,\n      riskScore,\n      factors,\n      mitigation,\n      timeline,\n    };\n  }\n\n  private checkCompliance(\n    vulnerabilities: Vulnerability[],\n    frameworks: ComplianceFramework[],\n  ): ComplianceResult[] {\n    const results: ComplianceResult[] = [];\n\n    for (const framework of frameworks) {\n      const result = this.evaluateFrameworkCompliance(framework, vulnerabilities);\n      results.push(result);\n    }\n\n    return results;\n  }\n\n  private evaluateFrameworkCompliance(\n    framework: ComplianceFramework,\n    vulnerabilities: Vulnerability[],\n  ): ComplianceResult {\n    // Simplified compliance checking\n    const findings: ComplianceFinding[] = [];\n\n    if (framework === 'owasp_top10') {\n      // Check OWASP Top 10 compliance\n      const injectionVulns = vulnerabilities.filter(v => v.type === 'injection');\n      findings.push({\n        requirement: 'A03:2021 – Injection',\n        status: injectionVulns.length === 0 ? 'pass' : 'fail',\n        details: `${injectionVulns.length} injection vulnerabilities found`,\n      });\n\n      const authVulns = vulnerabilities.filter(v => v.type === 'broken_authentication');\n      findings.push({\n        requirement: 'A07:2021 – Identification and Authentication Failures',\n        status: authVulns.length === 0 ? 'pass' : 'fail',\n        details: `${authVulns.length} authentication vulnerabilities found`,\n      });\n\n      const xssVulns = vulnerabilities.filter(v => v.type === 'cross_site_scripting');\n      findings.push({\n        requirement: 'A03:2021 – Injection (XSS)',\n        status: xssVulns.length === 0 ? 'pass' : 'fail',\n        details: `${xssVulns.length} XSS vulnerabilities found`,\n      });\n    }\n\n    const passed = findings.filter(f => f.status === 'pass').length;\n    const failed = findings.filter(f => f.status === 'fail').length;\n    const score = findings.length > 0 ? (passed / findings.length) * 100 : 100;\n\n    return {\n      framework,\n      score,\n      passed,\n      failed,\n      findings,\n    };\n  }\n\n  private generateRecommendations(\n    vulnerabilities: Vulnerability[],\n    riskAssessment: RiskAssessment,\n  ): Recommendation[] {\n    const recommendations: Recommendation[] = [];\n\n    // Critical priority recommendations\n    const criticalVulns = vulnerabilities.filter(v => v.severity === 'critical');\n    if (criticalVulns.length > 0) {\n      recommendations.push({\n        id: 'fix_critical_vulns',\n        priority: 'critical',\n        category: 'Vulnerability Management',\n        title: 'Address Critical Vulnerabilities Immediately',\n        description: `${criticalVulns.length} critical vulnerabilities require immediate attention`,\n        impact: 'Prevents potential system compromise and data breaches',\n        effort: 'High',\n        steps: [\n          'Review all critical vulnerabilities',\n          'Prioritize based on exploitability',\n          'Implement fixes or temporary mitigations',\n          'Test fixes in staging environment',\n          'Deploy fixes to production',\n          'Verify vulnerabilities are resolved',\n        ],\n      });\n    }\n\n    // Dependency management\n    const depVulns = vulnerabilities.filter(v => v.type === 'components_with_vulnerabilities');\n    if (depVulns.length > 0) {\n      recommendations.push({\n        id: 'update_dependencies',\n        priority: 'high',\n        category: 'Dependency Management',\n        title: 'Update Vulnerable Dependencies',\n        description: `${depVulns.length} vulnerable dependencies need updates`,\n        impact: 'Reduces third-party security risks',\n        effort: 'Medium',\n        steps: [\n          'Review vulnerable dependencies',\n          'Check for available updates',\n          'Test compatibility with updates',\n          'Update dependencies incrementally',\n          'Monitor for new vulnerabilities',\n        ],\n      });\n    }\n\n    // Code quality improvements\n    const codeVulns = vulnerabilities.filter(\n      v => v.type === 'injection' || v.type === 'cross_site_scripting',\n    );\n    if (codeVulns.length > 5) {\n      recommendations.push({\n        id: 'improve_code_quality',\n        priority: 'medium',\n        category: 'Code Quality',\n        title: 'Implement Secure Coding Practices',\n        description: 'Multiple code-level vulnerabilities indicate need for improved practices',\n        impact: 'Prevents future vulnerabilities and improves code quality',\n        effort: 'High',\n        steps: [\n          'Establish secure coding guidelines',\n          'Implement code review process',\n          'Add static analysis to CI/CD',\n          'Provide security training for developers',\n          'Use security linting tools',\n        ],\n      });\n    }\n\n    return recommendations;\n  }\n\n  private async storeScanResult(result: ScanResult): Promise<void> {\n    try {\n      this.scanHistory.push(result);\n\n      // Keep only recent scan history (last 50 scans)\n      if (this.scanHistory.length > 50) {\n        this.scanHistory.shift();\n      }\n\n      await AsyncStorage.setItem('vulnerability_scan_history', JSON.stringify(this.scanHistory));\n\n      // Store individual scan result\n      await AsyncStorage.setItem(`vulnerability_scan_${result.scanId}`, JSON.stringify(result));\n    } catch (error) {\n      console.error('Failed to store scan result:', error);\n    }\n  }\n\n  private async logScanResults(result: ScanResult): Promise<void> {\n    // Log to security monitoring service\n    await securityMonitoringService.logSecurityEvent({\n      type: 'configuration_change',\n      severity: result.riskAssessment.overallRisk,\n      source: 'VulnerabilityScanner',\n      description: `Security scan completed: ${result.vulnerabilities.length} vulnerabilities found`,\n      metadata: {\n        scanId: result.scanId,\n        riskScore: result.riskAssessment.riskScore,\n        criticalCount: result.statistics.vulnerabilitiesBySeverity.critical,\n        highCount: result.statistics.vulnerabilitiesBySeverity.high,\n      },\n    });\n\n    // Log critical vulnerabilities individually\n    const criticalVulns = result.vulnerabilities.filter(v => v.severity === 'critical');\n    for (const vuln of criticalVulns) {\n      await securityMonitoringService.logSecurityEvent({\n        type: 'suspicious_activity',\n        severity: 'critical',\n        source: 'VulnerabilityScanner',\n        description: `Critical vulnerability detected: ${vuln.title}`,\n        metadata: {\n          vulnerabilityId: vuln.id,\n          type: vuln.type,\n          location: vuln.location,\n          cve: vuln.cve,\n        },\n      });\n    }\n\n    // Track in observability service\n    observabilityService.trackSecurityEvent({\n      eventName: 'vulnerability_scan_completed',\n      severity: result.riskAssessment.overallRisk,\n      properties: {\n        scanId: result.scanId,\n        vulnerabilityCount: result.vulnerabilities.length,\n        riskScore: result.riskAssessment.riskScore,\n        duration: result.duration,\n        scanTypes: result.configuration.scanTypes,\n      },\n    });\n  }\n\n  async getScanHistory(limit = 10): Promise<ScanResult[]> {\n    return this.scanHistory.sort((a, b) => b.timestamp - a.timestamp).slice(0, limit);\n  }\n\n  async getScanResult(scanId: string): Promise<ScanResult | null> {\n    try {\n      const result = await AsyncStorage.getItem(`vulnerability_scan_${scanId}`);\n      return result ? JSON.parse(result) : null;\n    } catch (error) {\n      console.error('Failed to get scan result:', error);\n      return null;\n    }\n  }\n\n  async getVulnerabilityTrends(): Promise<{\n    trends: Array<{\n      date: string;\n      count: number;\n      severity: VulnerabilitySeverity;\n    }>;\n    summary: { improving: boolean; riskDirection: 'up' | 'down' | 'stable' };\n  }> {\n    const recentScans = this.scanHistory\n      .filter(scan => scan.timestamp > Date.now() - 30 * 24 * 60 * 60 * 1000) // Last 30 days\n      .sort((a, b) => a.timestamp - b.timestamp);\n\n    const trends = recentScans.map(scan => ({\n      date: new Date(scan.timestamp).toISOString().split('T')[0],\n      count: scan.vulnerabilities.length,\n      severity: scan.riskAssessment.overallRisk,\n    }));\n\n    // Determine trend direction\n    const improving =\n      recentScans.length >= 2 &&\n      recentScans[recentScans.length - 1].vulnerabilities.length <\n        recentScans[0].vulnerabilities.length;\n\n    const riskDirection =\n      recentScans.length >= 2\n        ? recentScans[recentScans.length - 1].riskAssessment.riskScore >\n          recentScans[0].riskAssessment.riskScore\n          ? 'up'\n          : 'down'\n        : 'stable';\n\n    return {\n      trends,\n      summary: { improving, riskDirection },\n    };\n  }\n\n  destroy(): void {\n    this.scanHistory.length = 0;\n    console.log('🛑 Vulnerability Scanner destroyed');\n  }\n}\n\n// Export singleton instance\nexport const vulnerabilityScanner = new VulnerabilityScanner();\nexport default vulnerabilityScanner;\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/services/WebSocketService.ts","messages":[{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":56,"column":38,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":56,"endColumn":40,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[1599,1601],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":153,"column":49,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":153,"endColumn":51,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[4079,4081],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'event' is defined but never used. Allowed unused args must match /^_/u.","line":163,"column":26,"nodeType":null,"messageId":"unusedVar","endLine":163,"endColumn":31},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":218,"column":5,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":227,"endColumn":8,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[5842,5842],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[5842,5842],"text":"await "},"desc":"Add await operator."}]},{"ruleId":"security/detect-object-injection","severity":1,"message":"Function Call Object Injection Sink","line":277,"column":43,"nodeType":"MemberExpression","endLine":277,"endColumn":56},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":343,"column":9,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":349,"endColumn":12,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[9505,9505],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[9505,9505],"text":"await "},"desc":"Add await operator."}]},{"ruleId":"security/detect-object-injection","severity":1,"message":"Generic Object Injection Sink","line":433,"column":12,"nodeType":"MemberExpression","endLine":433,"endColumn":32},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":433,"column":33,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":433,"endColumn":35,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[12204,12206],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { Platform } from 'react-native';\n\nimport { enhancedPerformanceService } from './EnhancedPerformanceService';\nimport { enhancedSecurityService } from './EnhancedSecurityService';\nimport { loggingService } from './LoggingService';\n\nexport interface WebSocketConfig {\n  url: string;\n  protocols?: string[];\n  reconnectAttempts: number;\n  reconnectInterval: number;\n  heartbeatInterval: number;\n  maxMessageQueueSize: number;\n  enableCompression: boolean;\n  authToken?: string;\n}\n\nexport interface WebSocketMessage {\n  id: string;\n  type: string;\n  payload: Record<string, unknown>;\n  timestamp: number;\n  priority: 'low' | 'normal' | 'high' | 'critical';\n  retryCount?: number;\n}\n\nexport interface WebSocketEventHandler {\n  (message: WebSocketMessage): void | Promise<void>;\n}\n\nexport interface ConnectionStats {\n  isConnected: boolean;\n  reconnectAttempts: number;\n  lastConnected?: Date;\n  lastDisconnected?: Date;\n  messagesSent: number;\n  messagesReceived: number;\n  queuedMessages: number;\n  averageLatency: number;\n  errors: number;\n}\n\nclass WebSocketService {\n  private ws: WebSocket | null = null;\n  private config: WebSocketConfig;\n  private eventHandlers: Map<string, Set<WebSocketEventHandler>> = new Map();\n  private messageQueue: WebSocketMessage[] = [];\n  private reconnectTimer: NodeJS.Timeout | null = null;\n  private heartbeatTimer: NodeJS.Timeout | null = null;\n  private isReconnecting = false;\n  private connectionStats: ConnectionStats;\n  private latencyTracking: Map<string, number> = new Map();\n\n  constructor() {\n    this.config = {\n      url: process.env.WEBSOCKET_URL || 'wss://api.kindred.app/ws',\n      reconnectAttempts: 5,\n      reconnectInterval: 5000,\n      heartbeatInterval: 30000,\n      maxMessageQueueSize: 100,\n      enableCompression: true,\n    };\n\n    this.connectionStats = {\n      isConnected: false,\n      reconnectAttempts: 0,\n      messagesSent: 0,\n      messagesReceived: 0,\n      queuedMessages: 0,\n      averageLatency: 0,\n      errors: 0,\n    };\n  }\n\n  async initialize(config?: Partial<WebSocketConfig>): Promise<void> {\n    const startTime = Date.now();\n\n    try {\n      if (config) {\n        this.config = { ...this.config, ...config };\n      }\n\n      // Set auth token from security service\n      const authToken = await enhancedSecurityService.secureRetrieve('auth_token');\n      if (authToken) {\n        this.config.authToken = authToken;\n      }\n\n      loggingService.info('WebSocket service initialized', {\n        url: this.config.url,\n        reconnectAttempts: this.config.reconnectAttempts,\n      });\n\n      enhancedPerformanceService.recordMetric(\n        'websocket_service_init',\n        Date.now() - startTime,\n        'ms',\n      );\n    } catch (error) {\n      loggingService.error('WebSocket service initialization failed', {\n        error: error.message,\n      });\n      throw error;\n    }\n  }\n\n  async connect(): Promise<void> {\n    if (this.ws?.readyState === WebSocket.OPEN) {\n      loggingService.warn('WebSocket already connected');\n      return;\n    }\n\n    const startTime = Date.now();\n\n    try {\n      await this.establishConnection();\n\n      this.connectionStats.lastConnected = new Date();\n      this.connectionStats.isConnected = true;\n      this.connectionStats.reconnectAttempts = 0;\n\n      // Start heartbeat\n      this.startHeartbeat();\n\n      // Process queued messages\n      await this.processMessageQueue();\n\n      enhancedPerformanceService.recordMetric(\n        'websocket_connection_time',\n        Date.now() - startTime,\n        'ms',\n      );\n\n      loggingService.info('WebSocket connected successfully');\n    } catch (error) {\n      this.connectionStats.errors++;\n      loggingService.error('WebSocket connection failed', {\n        error: error.message,\n      });\n\n      if (!this.isReconnecting) {\n        this.scheduleReconnect();\n      }\n\n      throw error;\n    }\n  }\n\n  private async establishConnection(): Promise<void> {\n    return new Promise((resolve, reject) => {\n      try {\n        const wsUrl = this.buildConnectionUrl();\n        const protocols = this.config.protocols || [];\n\n        this.ws = new WebSocket(wsUrl, protocols);\n\n        // Configure WebSocket options\n        if (Platform.OS !== 'web') {\n          // React Native specific configurations\n          (this.ws as WebSocket & { binaryType: string }).binaryType = 'arraybuffer';\n        }\n\n        this.ws.onopen = event => {\n          loggingService.info('WebSocket connection opened');\n          this.setupEventHandlers();\n          resolve();\n        };\n\n        this.ws.onclose = event => {\n          this.handleDisconnection(event.code, event.reason);\n        };\n\n        this.ws.onerror = error => {\n          loggingService.error('WebSocket error', { error });\n          this.connectionStats.errors++;\n          reject(new Error(`WebSocket connection error: ${error}`));\n        };\n\n        this.ws.onmessage = event => {\n          this.handleIncomingMessage(event.data);\n        };\n\n        // Connection timeout\n        setTimeout(() => {\n          if (this.ws?.readyState !== WebSocket.OPEN) {\n            this.ws?.close();\n            reject(new Error('WebSocket connection timeout'));\n          }\n        }, 10000);\n      } catch (error) {\n        reject(error);\n      }\n    });\n  }\n\n  private buildConnectionUrl(): string {\n    const url = new URL(this.config.url);\n\n    // Add authentication\n    if (this.config.authToken) {\n      url.searchParams.set('token', this.config.authToken);\n    }\n\n    // Add client info\n    url.searchParams.set('platform', Platform.OS);\n    url.searchParams.set('version', '1.0.0');\n\n    // Add compression support\n    if (this.config.enableCompression) {\n      url.searchParams.set('compression', 'gzip');\n    }\n\n    return url.toString();\n  }\n\n  private setupEventHandlers(): void {\n    // Send connection acknowledgment\n    this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'connection_ack',\n      payload: {\n        platform: Platform.OS,\n        timestamp: Date.now(),\n      },\n      timestamp: Date.now(),\n      priority: 'high',\n    });\n  }\n\n  private handleIncomingMessage(data: string | ArrayBuffer): void {\n    try {\n      const messageData = typeof data === 'string' ? data : this.arrayBufferToString(data);\n      const message: WebSocketMessage = JSON.parse(messageData);\n\n      // Track latency for ping/pong messages\n      if (message.type === 'pong' && message.id) {\n        const sentTime = this.latencyTracking.get(message.id);\n        if (sentTime) {\n          const latency = Date.now() - sentTime;\n          this.updateLatencyStats(latency);\n          this.latencyTracking.delete(message.id);\n        }\n      }\n\n      this.connectionStats.messagesReceived++;\n\n      // Emit to registered handlers\n      const handlers = this.eventHandlers.get(message.type);\n      if (handlers) {\n        handlers.forEach(async handler => {\n          try {\n            await handler(message);\n          } catch (error) {\n            loggingService.error('Error in WebSocket message handler', {\n              messageType: message.type,\n              error: error.message,\n            });\n          }\n        });\n      }\n\n      loggingService.debug('WebSocket message received', {\n        type: message.type,\n        id: message.id,\n      });\n    } catch (error) {\n      loggingService.error('Error parsing WebSocket message', {\n        error: error.message,\n      });\n    }\n  }\n\n  private arrayBufferToString(buffer: ArrayBuffer): string {\n    const uint8Array = new Uint8Array(buffer);\n    let binaryString = '';\n    for (let i = 0; i < uint8Array.length; i++) {\n      binaryString += String.fromCharCode(uint8Array[i]);\n    }\n    return binaryString;\n  }\n\n  private handleDisconnection(code: number, reason: string): void {\n    this.connectionStats.isConnected = false;\n    this.connectionStats.lastDisconnected = new Date();\n\n    this.stopHeartbeat();\n\n    loggingService.warn('WebSocket disconnected', { code, reason });\n\n    // Emit disconnection event\n    this.emitEvent('connection_lost', {\n      code,\n      reason,\n      timestamp: Date.now(),\n    });\n\n    // Schedule reconnection for non-intentional disconnections\n    if (code !== 1000 && !this.isReconnecting) {\n      this.scheduleReconnect();\n    }\n  }\n\n  private scheduleReconnect(): void {\n    if (this.connectionStats.reconnectAttempts >= this.config.reconnectAttempts) {\n      loggingService.error('Max reconnection attempts reached');\n      this.emitEvent('connection_failed', {\n        attempts: this.connectionStats.reconnectAttempts,\n        timestamp: Date.now(),\n      });\n      return;\n    }\n\n    this.isReconnecting = true;\n    this.connectionStats.reconnectAttempts++;\n\n    const delay = this.config.reconnectInterval * this.connectionStats.reconnectAttempts;\n\n    this.reconnectTimer = setTimeout(async () => {\n      try {\n        loggingService.info('Attempting WebSocket reconnection', {\n          attempt: this.connectionStats.reconnectAttempts,\n        });\n\n        await this.connect();\n        this.isReconnecting = false;\n      } catch (error) {\n        loggingService.error('Reconnection attempt failed', {\n          error: error.message,\n        });\n        this.scheduleReconnect();\n      }\n    }, delay);\n  }\n\n  private startHeartbeat(): void {\n    this.stopHeartbeat();\n\n    this.heartbeatTimer = setInterval(() => {\n      if (this.ws?.readyState === WebSocket.OPEN) {\n        const pingId = this.generateMessageId();\n        this.latencyTracking.set(pingId, Date.now());\n\n        this.sendMessage({\n          id: pingId,\n          type: 'ping',\n          payload: { timestamp: Date.now() },\n          timestamp: Date.now(),\n          priority: 'low',\n        });\n      }\n    }, this.config.heartbeatInterval);\n  }\n\n  private stopHeartbeat(): void {\n    if (this.heartbeatTimer) {\n      clearInterval(this.heartbeatTimer);\n      this.heartbeatTimer = null;\n    }\n  }\n\n  private updateLatencyStats(latency: number): void {\n    const totalLatency = this.connectionStats.averageLatency * this.connectionStats.messagesSent;\n    this.connectionStats.averageLatency =\n      (totalLatency + latency) / (this.connectionStats.messagesSent + 1);\n\n    enhancedPerformanceService.recordMetric('websocket_latency', latency, 'ms');\n  }\n\n  async sendMessage(message: WebSocketMessage): Promise<void> {\n    // Add to queue if not connected\n    if (this.ws?.readyState !== WebSocket.OPEN) {\n      this.queueMessage(message);\n      return;\n    }\n\n    try {\n      const messageData = JSON.stringify(message);\n\n      // Send based on priority\n      this.ws.send(messageData);\n\n      this.connectionStats.messagesSent++;\n\n      loggingService.debug('WebSocket message sent', {\n        type: message.type,\n        id: message.id,\n        priority: message.priority,\n      });\n    } catch (error) {\n      loggingService.error('Error sending WebSocket message', {\n        error: error.message,\n        messageType: message.type,\n      });\n\n      // Queue message for retry\n      this.queueMessage(message);\n    }\n  }\n\n  private queueMessage(message: WebSocketMessage): void {\n    // Remove oldest low-priority messages if queue is full\n    if (this.messageQueue.length >= this.config.maxMessageQueueSize) {\n      const lowPriorityIndex = this.messageQueue.findIndex(msg => msg.priority === 'low');\n      if (lowPriorityIndex !== -1) {\n        this.messageQueue.splice(lowPriorityIndex, 1);\n      } else {\n        this.messageQueue.shift(); // Remove oldest message\n      }\n    }\n\n    // Insert message based on priority\n    const insertIndex = this.messageQueue.findIndex(\n      msg => this.getPriorityValue(msg.priority) < this.getPriorityValue(message.priority),\n    );\n\n    if (insertIndex === -1) {\n      this.messageQueue.push(message);\n    } else {\n      this.messageQueue.splice(insertIndex, 0, message);\n    }\n\n    this.connectionStats.queuedMessages = this.messageQueue.length;\n\n    loggingService.debug('Message queued', {\n      type: message.type,\n      priority: message.priority,\n      queueSize: this.messageQueue.length,\n    });\n  }\n\n  private getPriorityValue(priority: string): number {\n    const priorities = { low: 1, normal: 2, high: 3, critical: 4 };\n    return priorities[priority] || 2;\n  }\n\n  private async processMessageQueue(): Promise<void> {\n    while (this.messageQueue.length > 0 && this.ws?.readyState === WebSocket.OPEN) {\n      const message = this.messageQueue.shift()!;\n      await this.sendMessage(message);\n    }\n\n    this.connectionStats.queuedMessages = this.messageQueue.length;\n  }\n\n  subscribe(eventType: string, handler: WebSocketEventHandler): () => void {\n    if (!this.eventHandlers.has(eventType)) {\n      this.eventHandlers.set(eventType, new Set());\n    }\n\n    this.eventHandlers.get(eventType)!.add(handler);\n\n    loggingService.debug('WebSocket event handler subscribed', { eventType });\n\n    // Return unsubscribe function\n    return () => {\n      const handlers = this.eventHandlers.get(eventType);\n      if (handlers) {\n        handlers.delete(handler);\n        if (handlers.size === 0) {\n          this.eventHandlers.delete(eventType);\n        }\n      }\n    };\n  }\n\n  private emitEvent(eventType: string, payload: Record<string, unknown>): void {\n    const message: WebSocketMessage = {\n      id: this.generateMessageId(),\n      type: eventType,\n      payload,\n      timestamp: Date.now(),\n      priority: 'normal',\n    };\n\n    this.handleIncomingMessage(JSON.stringify(message));\n  }\n\n  disconnect(): void {\n    this.isReconnecting = false;\n    this.stopHeartbeat();\n\n    if (this.reconnectTimer) {\n      clearTimeout(this.reconnectTimer);\n      this.reconnectTimer = null;\n    }\n\n    if (this.ws) {\n      this.ws.close(1000, 'Client disconnect');\n      this.ws = null;\n    }\n\n    this.connectionStats.isConnected = false;\n    this.connectionStats.lastDisconnected = new Date();\n\n    loggingService.info('WebSocket disconnected by client');\n  }\n\n  getConnectionStats(): ConnectionStats {\n    return { ...this.connectionStats };\n  }\n\n  isConnected(): boolean {\n    return this.ws?.readyState === WebSocket.OPEN && this.connectionStats.isConnected;\n  }\n\n  async updateAuthToken(token: string): Promise<void> {\n    this.config.authToken = token;\n    await enhancedSecurityService.secureStore('auth_token', token);\n\n    // Reconnect with new token if currently connected\n    if (this.isConnected()) {\n      this.disconnect();\n      await this.connect();\n    }\n  }\n\n  private generateMessageId(): string {\n    return `${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;\n  }\n\n  // Convenience methods for common message types\n  async sendCarbonUpdate(carbonData: Record<string, unknown>): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'carbon_update',\n      payload: carbonData,\n      timestamp: Date.now(),\n      priority: 'normal',\n    });\n  }\n\n  async sendAchievementUnlock(achievement: Record<string, unknown>): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'achievement_unlocked',\n      payload: achievement,\n      timestamp: Date.now(),\n      priority: 'high',\n    });\n  }\n\n  async sendChallengeProgress(progress: Record<string, unknown>): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'challenge_progress',\n      payload: progress,\n      timestamp: Date.now(),\n      priority: 'normal',\n    });\n  }\n\n  async sendFriendActivity(activity: Record<string, unknown>): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'friend_activity',\n      payload: activity,\n      timestamp: Date.now(),\n      priority: 'normal',\n    });\n  }\n\n  async joinRoom(roomId: string): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'join_room',\n      payload: { roomId },\n      timestamp: Date.now(),\n      priority: 'high',\n    });\n  }\n\n  async leaveRoom(roomId: string): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'leave_room',\n      payload: { roomId },\n      timestamp: Date.now(),\n      priority: 'high',\n    });\n  }\n\n  async sendChatMessage(roomId: string, message: string): Promise<void> {\n    await this.sendMessage({\n      id: this.generateMessageId(),\n      type: 'chat_message',\n      payload: { roomId, message },\n      timestamp: Date.now(),\n      priority: 'normal',\n    });\n  }\n}\n\n// Create and export singleton instance\nexport const webSocketService = new WebSocketService();\nexport default webSocketService;\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/services/ZeroTrustSecurityService.ts","messages":[{"ruleId":"security/detect-object-injection","severity":1,"message":"Generic Object Injection Sink","line":148,"column":7,"nodeType":"MemberExpression","endLine":148,"endColumn":21},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'algorithm' is assigned a value but never used. Allowed unused args must match /^_/u.","line":169,"column":5,"nodeType":null,"messageId":"unusedVar","endLine":169,"endColumn":14},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":188,"column":40,"node