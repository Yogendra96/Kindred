CarbonTracker {...defaultProps} activities={activities} />);\n      }\n\n      const finalMemory = TestHelpers.measureMemoryUsage();\n\n      if (initialMemory && finalMemory) {\n        const memoryIncrease = finalMemory.used - initialMemory.used;\n        expect(memoryIncrease).toBeLessThan(10 * 1024 * 1024); // Less than 10MB increase\n      }\n    });\n  });\n\n  describe('Edge Cases', () => {\n    it('should handle invalid distance input gracefully', async () => {\n      render(<MockCarbonTracker {...defaultProps} />);\n\n      const activityTypeInput = screen.getByTestId('activity-type-input');\n      const distanceInput = screen.getByTestId('distance-input');\n      const addButton = screen.getByTestId('add-activity-button');\n\n      fireEvent.changeText(activityTypeInput, 'walking');\n      fireEvent.changeText(distanceInput, 'invalid');\n      fireEvent.press(addButton);\n\n      await waitFor(() => {\n        expect(mockOnActivityAdd).toHaveBeenCalledWith(\n          expect.objectContaining({\n            distance: NaN,\n            carbonSaved: NaN,\n          }),\n        );\n      });\n    });\n\n    it('should handle negative distance input', async () => {\n      render(<MockCarbonTracker {...defaultProps} />);\n\n      const activityTypeInput = screen.getByTestId('activity-type-input');\n      const distanceInput = screen.getByTestId('distance-input');\n      const addButton = screen.getByTestId('add-activity-button');\n\n      fireEvent.changeText(activityTypeInput, 'walking');\n      fireEvent.changeText(distanceInput, '-5');\n      fireEvent.press(addButton);\n\n      await waitFor(() => {\n        expect(mockOnActivityAdd).toHaveBeenCalledWith(\n          expect.objectContaining({\n            distance: -5,\n            carbonSaved: -2.5,\n          }),\n        );\n      });\n    });\n\n    it('should handle very large numbers', async () => {\n      render(<MockCarbonTracker {...defaultProps} />);\n\n      const activityTypeInput = screen.getByTestId('activity-type-input');\n      const distanceInput = screen.getByTestId('distance-input');\n      const addButton = screen.getByTestId('add-activity-button');\n\n      fireEvent.changeText(activityTypeInput, 'walking');\n      fireEvent.changeText(distanceInput, '999999');\n      fireEvent.press(addButton);\n\n      await waitFor(() => {\n        expect(mockOnActivityAdd).toHaveBeenCalledWith(\n          expect.objectContaining({\n            distance: 999999,\n            carbonSaved: 499999.5,\n          }),\n        );\n      });\n    });\n  });\n\n  describe('Accessibility', () => {\n    it('should be accessible to screen readers', () => {\n      render(<MockCarbonTracker {...defaultProps} />);\n\n      const activityTypeInput = screen.getByTestId('activity-type-input');\n      const distanceInput = screen.getByTestId('distance-input');\n      const addButton = screen.getByTestId('add-activity-button');\n\n      expect(activityTypeInput).toBeTruthy();\n      expect(distanceInput).toBeTruthy();\n      expect(addButton).toBeTruthy();\n    });\n\n    it('should have proper labels for form fields', () => {\n      render(<MockCarbonTracker {...defaultProps} />);\n\n      expect(screen.getByTestId('activity-type-label')).toHaveTextContent('Activity Type');\n      expect(screen.getByTestId('distance-label')).toHaveTextContent('Distance (km)');\n    });\n  });\n\n  describe('Integration', () => {\n    it('should work with Redux store', () => {\n      const initialState = {\n        carbon: {\n          activities: [TestDataFactory.createCarbonActivity()],\n          totalSaved: 2.5,\n        },\n      };\n\n      render(<MockCarbonTracker {...defaultProps} />, { initialState });\n\n      // Component should integrate with Redux state\n      expect(screen.getByTestId('carbon-saved-display')).toBeTruthy();\n    });\n\n    it('should work with React Query', async () => {\n      const queryClient = TestHelpers.createMockQueryClient();\n\n      render(<MockCarbonTracker {...defaultProps} />, { queryClient });\n\n      // Component should work with React Query\n      expect(screen.getByTestId('add-activity-button')).toBeTruthy();\n    });\n  });\n});\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/tests/services/AchievementSystem.test.ts","messages":[{"ruleId":"jest/prefer-strict-equal","severity":2,"message":"Use `toStrictEqual()` instead","line":141,"column":28,"nodeType":"Identifier","messageId":"useToStrictEqual","endLine":141,"endColumn":35,"suggestions":[{"messageId":"suggestReplaceWithStrictEqual","fix":{"range":[4598,4605],"text":"toStrictEqual"},"desc":"Replace with `toStrictEqual()`"}]},{"ruleId":"jest/prefer-strict-equal","severity":2,"message":"Use `toStrictEqual()` instead","line":230,"column":34,"nodeType":"Identifier","messageId":"useToStrictEqual","endLine":230,"endColumn":41,"suggestions":[{"messageId":"suggestReplaceWithStrictEqual","fix":{"range":[7526,7533],"text":"toStrictEqual"},"desc":"Replace with `toStrictEqual()`"}]},{"ruleId":"jest/prefer-strict-equal","severity":2,"message":"Use `toStrictEqual()` instead","line":351,"column":28,"nodeType":"Identifier","messageId":"useToStrictEqual","endLine":351,"endColumn":35,"suggestions":[{"messageId":"suggestReplaceWithStrictEqual","fix":{"range":[11577,11584],"text":"toStrictEqual"},"desc":"Replace with `toStrictEqual()`"}]}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import AsyncStorage from '@react-native-async-storage/async-storage';\nimport auth from '@reac