es.buttonContainer}>\n            {canRetry && (\n              <TouchableOpacity\n                style={[styles.button, styles.retryButton]}\n                onPress={this.handleRetry}\n                activeOpacity={0.8}\n              >\n                <Text style={styles.retryButtonText}>\n                  {retryCount > 0 ? `Retry (${retryCount}/${maxRetries})` : 'Try Again'}\n                </Text>\n              </TouchableOpacity>\n            )}\n\n            <TouchableOpacity\n              style={[styles.button, styles.reportButton]}\n              onPress={this.handleReportIssue}\n              activeOpacity={0.8}\n              disabled={isReporting}\n            >\n              <Text style={styles.reportButtonText}>\n                {isReporting ? 'Reporting...' : 'Report Issue'}\n              </Text>\n            </TouchableOpacity>\n          </View>\n\n          {/* Retry Count Info */}\n          {retryCount > 0 && (\n            <Text style={styles.retryInfo}>\n              Attempted {retryCount} time{retryCount > 1 ? 's' : ''}\n            </Text>\n          )}\n        </ScrollView>\n      </View>\n    );\n  }\n\n  render(): ReactNode {\n    if (this.state.hasError) {\n      return this.renderErrorFallback();\n    }\n\n    return this.props.children;\n  }\n\n  // Public methods for external breadcrumb/action tracking\n  public static addBreadcrumb = (breadcrumb: ErrorBreadcrumb): void => {\n    // This would need to be implemented with a global error boundary manager\n    console.warn('Global breadcrumb:', breadcrumb);\n  };\n\n  public static addUserAction = (action: UserAction): void => {\n    // This would need to be implemented with a global error boundary manager\n    console.warn('Global user action:', action);\n  };\n}\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#f8f9fa',\n  },\n  scrollView: {\n    flex: 1,\n  },\n  scrollContent: {\n    flexGrow: 1,\n    justifyContent: 'center',\n    alignItems: 'center',\n    padding: 20,\n    minHeight: height * 0.8,\n  },\n  iconContainer: {\n    marginBottom: 20,\n  },\n  errorIcon: {\n    fontSize: 64,\n    textAlign: 'center',\n  },\n  title: {\n    fontSize: 24,\n    fontWeight: 'bold',\n    color: '#dc3545',\n    textAlign: 'center',\n    marginBottom: 12,\n  },\n  message: {\n    fontSize: 16,\n    color: '#6c757d',\n    textAlign: 'center',\n    marginBottom: 24,\n    lineHeight: 24,\n    paddingHorizontal: 20,\n  },\n  detailsButton: {\n    paddingVertical: 8,\n    paddingHorizontal: 16,\n    marginBottom: 20,\n  },\n  detailsButtonText: {\n    fontSize: 14,\n    color: '#007bff',\n    textDecorationLine: 'underline',\n  },\n  detailsContainer: {\n    backgroundColor: '#f8f9fa',\n    borderRadius: 8,\n    padding: 16,\n    marginBottom: 24,\n    width: '100%',\n    maxWidth: width - 40,\n  },\n  detailsTitle: {\n    fontSize: 14,\n    fontWeight: 'bold',\n    color: '#495057',\n    marginBottom: 8,\n    marginTop: 12,\n  },\n  errorText: {\n    fontSize: 12,\n    color: '#dc3545',\n    fontFamily: Platform.OS === 'ios' ? 'Menlo' : 'monospace',\n    marginBottom: 8,\n  },\n  stackText: {\n    fontSize: 10,\n    color: '#6c757d',\n    fontFamily: Platform.OS === 'ios' ? 'Menlo' : 'monospace',\n    lineHeight: 14,\n  },\n  buttonContainer: {\n    width: '100%',\n    maxWidth: 300,\n    gap: 12,\n  },\n  button: {\n    paddingVertical: 12,\n    paddingHorizontal: 24,\n    borderRadius: 8,\n    alignItems: 'center',\n  },\n  retryButton: {\n    backgroundColor: '#28a745',\n  },\n  retryButtonText: {\n    color: '#ffffff',\n    fontSize: 16,\n    fontWeight: '600',\n  },\n  reportButton: {\n    backgroundColor: '#6c757d',\n  },\n  reportButtonText: {\n    color: '#ffffff',\n    fontSize: 16,\n    fontWeight: '600',\n  },\n  retryInfo: {\n    fontSize: 12,\n    color: '#6c757d',\n    textAlign: 'center',\n    marginTop: 16,\n  },\n});\n\nexport default ErrorBoundary;\n\n// Higher-order component for easy wrapping\nexport function withErrorBoundary<P extends object>(\n  Component: React.ComponentType<P>,\n  errorBoundaryProps?: Omit<ErrorBoundaryProps, 'children'>,\n) {\n  const WrappedComponent = (props: P) => (\n    <ErrorBoundary {...errorBoundaryProps}>\n      <Component {...props} />\n    </ErrorBoundary>\n  );\n\n  WrappedComponent.displayName = `withErrorBoundary(${Component.displayName || Component.name})`;\n\n  return WrappedComponent;\n}\n\n// Hook for error boundary context\nexport function useErrorHandler() {\n  return {\n    addBreadcrumb: ErrorBoundary.addBreadcrumb,\n    addUserAction: ErrorBoundary.addUserAction,\n  };\n}\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/components/LoggingDashboard.tsx","messages":[{"ruleId":"perfectionist/sort-named-imports","severity":2,"message":"Expected \"useEffect\" to come before \"useState\".","line":6,"column":27,"nodeType":"ImportSpecifier","messageId":"unexpectedNamedImportsOrder","endLine":6,"endColumn":36,"fix":{"range":[147,166],"text":"useEffect, useState"}},{"ruleId":"perfectionist/sort-named-imports","severity":2,"message":"Expected \"LogAnalytics\" to come before \"LogQuery\".","line":26,"column":3,"nodeType":"ImportSpecifier","messageId":"unexpectedNamedImportsOrder","endLine":26,"endColumn":20,"fix":{"range":[408,476],"text":"type LogAnalytics,\n  type LogEntry,\n  type LogLevel,\n  type LogQuery"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":42,"column":1,"nodeType":null,"messageId":"delete","endLine":42,"endColumn":3,"fix":{"range":[1173,1175],"text":""