ackgroundColor: 'red' }} testID='red-skeleton' />,\n      );\n\n      const skeleton = screen.getByTestID('red-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n  });\n\n  describe('Edge Cases', () => {\n    it('handles zero lines for text variant', () => {\n      render(<SkeletonLoader variant='text' lines={0} testID='no-lines-skeleton' />);\n\n      const skeleton = screen.getByTestID('no-lines-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles zero items for list variant', () => {\n      render(<SkeletonLoader variant='list' items={0} testID='no-items-skeleton' />);\n\n      const skeleton = screen.getByTestID('no-items-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles zero columns for grid variant', () => {\n      render(<SkeletonLoader variant='grid' columns={0} testID='no-columns-skeleton' />);\n\n      const skeleton = screen.getByTestID('no-columns-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles very large dimensions', () => {\n      render(<SkeletonLoader variant='base' width={1000} height={500} testID='large-skeleton' />);\n\n      const skeleton = screen.getByTestID('large-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles very small dimensions', () => {\n      render(<SkeletonLoader variant='base' width={1} height={1} testID='tiny-skeleton' />);\n\n      const skeleton = screen.getByTestID('tiny-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n  });\n\n  describe('Component Composition', () => {\n    it('can be used within other components', () => {\n      const TestWrapper = () => (\n        <View testID='wrapper'>\n          <SkeletonLoader variant='base' testID='nested-skeleton' />\n        </View>\n      );\n\n      render(<TestWrapper />);\n\n      const wrapper = screen.getByTestID('wrapper');\n      const skeleton = screen.getByTestID('nested-skeleton');\n\n      expect(wrapper).toBeTruthy();\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('can render multiple skeletons', () => {\n      render(\n        <View>\n          <SkeletonLoader variant='circle' testID='skeleton-1' />\n          <SkeletonLoader variant='text' testID='skeleton-2' />\n          <SkeletonLoader variant='image' testID='skeleton-3' />\n        </View>,\n      );\n\n      expect(screen.getByTestID('skeleton-1')).toBeTruthy();\n      expect(screen.getByTestID('skeleton-2')).toBeTruthy();\n      expect(screen.getByTestID('skeleton-3')).toBeTruthy();\n    });\n  });\n\n  describe('Performance', () => {\n    it('renders efficiently with many items', () => {\n      const startTime = Date.now();\n\n      render(<SkeletonLoader variant='list' items={100} testID='performance-skeleton' />);\n\n      const endTime = Date.now();\n      const renderTime = endTime - startTime;\n\n      const skeleton = screen.getByTestID('performance-skeleton');\n      expect(skeleton).toBeTruthy();\n\n      // Ensure rendering doesn't take too long (adjust threshold as needed)\n      expect(renderTime).toBeLessThan(1000);\n    });\n\n    it('handles rapid re-renders', () => {\n      const { rerender } = render(\n        <SkeletonLoader variant='base' width={100} testID='rerender-skeleton' />,\n      );\n\n      // Rapidly change props\n      for (let i = 0; i < 10; i++) {\n        rerender(<SkeletonLoader variant='base' width={100 + i * 10} testID='rerender-skeleton' />);\n      }\n\n      const skeleton = screen.getByTestID('rerender-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n  });\n\n  describe('Error Handling', () => {\n    it('handles invalid variant gracefully', () => {\n      // TypeScript would catch this, but testing runtime behavior\n      render(<SkeletonLoader variant={'invalid' as any} testID='invalid-skeleton' />);\n\n      const skeleton = screen.getByTestID('invalid-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles negative dimensions', () => {\n      render(\n        <SkeletonLoader variant='base' width={-100} height={-50} testID='negative-skeleton' />,\n      );\n\n      const skeleton = screen.getByTestID('negative-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n\n    it('handles undefined props gracefully', () => {\n      render(\n        <SkeletonLoader\n          variant='base'\n          width={undefined}\n          height={undefined}\n          testID='undefined-props-skeleton'\n        />,\n      );\n\n      const skeleton = screen.getByTestID('undefined-props-skeleton');\n      expect(skeleton).toBeTruthy();\n    });\n  });\n});\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/components/common/AccessibleButton.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'react-native' import is duplicated.","line":8,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":8,"endColumn":93},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":86,"column":24,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":86,"endColumn":26,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[2385,2412],"text":"(accessibilityLabel ?? label)"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":86,"co