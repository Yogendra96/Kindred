arams?: Record<string, any>): Promise<void> {\n    if (!this.isEnabled) return;\n\n    try {\n      await analytics().logScreenView({\n        screen_name: screenName,\n        screen_class: screenName,\n        ...params,\n      });\n    } catch (error) {\n      loggingService.error('Failed to log screen view', { error, screenName });\n    }\n  }\n\n  async logEvent(eventName: string, params?: Record<string, any>): Promise<void> {\n    if (!this.isEnabled) return;\n\n    try {\n      await analytics().logEvent(eventName, {\n        timestamp: new Date().toISOString(),\n        platform: Platform.OS,\n        ...params,\n      });\n    } catch (error) {\n      loggingService.error('Failed to log event', { error, eventName });\n    }\n  }\n\n  // Carbon footprint tracking events\n  async logCarbonFootprintAdded(value: number, category: string): Promise<void> {\n    await this.logEvent('carbon_footprint_added', {\n      value,\n      category,\n      timestamp: new Date().toISOString(),\n    });\n  }\n\n  async logActivityCompleted(type: string, duration: number, carbonSaved: number): Promise<void> {\n    await this.logEvent('activity_completed', {\n      type,\n      duration,\n      carbon_saved: carbonSaved,\n    });\n  }\n\n  async logEcoTipViewed(tipId: string, category: string): Promise<void> {\n    await this.logEvent('eco_tip_viewed', {\n      tip_id: tipId,\n      category,\n    });\n  }\n\n  // User engagement events\n  async logUserEngagement(\n    actionName: string,\n    duration: number,\n    params?: Record<string, any>,\n  ): Promise<void> {\n    await this.logEvent('user_engagement', {\n      action: actionName,\n      duration,\n      ...params,\n    });\n  }\n\n  // Error tracking\n  async logError(errorCode: string, message: string, fatal: boolean = false): Promise<void> {\n    await this.logEvent('app_error', {\n      error_code: errorCode,\n      error_message: message,\n      fatal,\n    });\n  }\n\n  // Performance tracking\n  async logPerformanceMetric(\n    metricName: string,\n    value: number,\n    params?: Record<string, any>,\n  ): Promise<void> {\n    await this.logEvent('performance_metric', {\n      metric_name: metricName,\n      value,\n      ...params,\n    });\n  }\n\n  enableAnalytics(enabled: boolean): void {\n    this.isEnabled = enabled;\n    analytics().setAnalyticsCollectionEnabled(enabled);\n  }\n\n  async resetAnalyticsData(): Promise<void> {\n    if (!this.isEnabled) return;\n\n    try {\n      await analytics().resetAnalyticsData();\n      loggingService.info('Analytics data reset successfully');\n    } catch (error) {\n      loggingService.error('Failed to reset analytics data', { error });\n    }\n  }\n}\n\nexport const analyticsService = AnalyticsService.getInstance();\nexport default analyticsService;\n","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/services/AnimatedTransitionsService.ts","messages":[{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":241,"column":62,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":241,"endColumn":64,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[7145,7147],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":244,"column":30,"n