":"prettier/prettier","severity":2,"message":"Delete `······`","line":127,"column":1,"nodeType":null,"messageId":"delete","endLine":127,"endColumn":7,"fix":{"range":[3658,3664],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":131,"column":1,"nodeType":null,"messageId":"delete","endLine":131,"endColumn":7,"fix":{"range":[3759,3765],"text":""}},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":134,"column":33,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":134,"endColumn":35,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[3877,3879],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":140,"column":1,"nodeType":null,"messageId":"delete","endLine":140,"endColumn":3,"fix":{"range":[4024,4026],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":143,"column":1,"nodeType":null,"messageId":"delete","endLine":143,"endColumn":5,"fix":{"range":[4097,4101],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"slide\"` with `'slide'`","line":147,"column":23,"nodeType":null,"messageId":"replace","endLine":147,"endColumn":30,"fix":{"range":[4182,4189],"text":"'slide'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"pageSheet\"` with `'pageSheet'`","line":148,"column":27,"nodeType":null,"messageId":"replace","endLine":148,"endColumn":38,"fix":{"range":[4216,4227],"text":"'pageSheet'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··············onPress={()·=>·setSelectedLog(null)}⏎··············style={styles.closeButton}⏎············` with `·onPress={()·=>·setSelectedLog(null)}·style={styles.closeButton}`","line":154,"column":30,"nodeType":null,"messageId":"replace","endLine":157,"endColumn":13,"fix":{"range":[4469,4574],"text":" onPress={() => setSelectedLog(null)} style={styles.closeButton}"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"close\"·size={24}·color=\"#007AFF\"` with `'close'·size={24}·color='#007AFF'`","line":158,"column":26,"nodeType":null,"messageId":"replace","endLine":158,"endColumn":59,"fix":{"range":[4601,4634],"text":"'close' size={24} color='#007AFF'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··········`","line":161,"column":1,"nodeType":null,"messageId":"delete","endLine":161,"endColumn":11,"fix":{"range":[4688,4698],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Time:·{new·Date(selectedLog.timestamp).toLocaleString()}` with `⏎················Time:·{new·Date(selectedLog.timestamp).toLocaleString()}⏎··············`","line":166,"column":47,"nodeType":null,"messageId":"replace","endLine":166,"endColumn":103,"fix":{"range":[4989,5045],"text":"\n                Time: {new Date(selectedLog.timestamp).toLocaleString()}\n              "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `············`","line":170,"column":1,"nodeType":null,"messageId":"delete","endLine":170,"endColumn":13,"fix":{"range":[5251,5263],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `············`","line":175,"column":1,"nodeType":null,"messageId":"delete","endLine":175,"endColumn":13,"fix":{"range":[5472,5484],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `············`","line":188,"column":1,"nodeType":null,"messageId":"delete","endLine":188,"endColumn":13,"fix":{"range":[6094,6106],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":202,"column":1,"nodeType":null,"messageId":"delete","endLine":202,"endColumn":3,"fix":{"range":[6534,6536],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":205,"column":1,"nodeType":null,"messageId":"delete","endLine":205,"endColumn":5,"fix":{"range":[6604,6608],"text":""}},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: '#FF3B30' }","line":216,"column":47,"nodeType":"ObjectExpression","endLine":216,"endColumn":67},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: '#FF3B30' }","line":216,"column":47,"nodeType":"ObjectExpression","endLine":216,"endColumn":67},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":223,"column":1,"nodeType":null,"messageId":"delete","endLine":223,"endColumn":9,"fix":{"range":[7353,7361],"text":""}},{"ruleId":"security/detect-object-injection","severity":1,"message":"Generic Object Injection Sink","line":227,"column":27,"nodeType":"MemberExpression","endLine":227,"endColumn":55},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `············`","line":229,"column":1,"nodeType":null,"messageId":"delete","endLine":229,"endColumn":13,"fix":{"range":[7668,7680],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":251,"column":1,"nodeType":null,"messageId":"delete","endLine":251,"endColumn":9,"fix":{"range":[8408,8416],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":261,"column":1,"nodeType":null,"messageId":"delete","endLine":261,"endColumn":9,"fix":{"range":[8850,8858],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":278,"column":1,"nodeType":null,"messageId":"delete","endLine":278,"endColumn":3,"fix":{"range":[9429,9431],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"Search·logs...\"` with `'Search·logs...'`","line":283,"column":21,"nodeType":null,"messageId":"replace","endLine":283,"endColumn":37,"fix":{"range":[9577,9593],"text":"'Search logs...'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"while-editing\"` with `'while-editing'`","line":286,"column":25,"nodeType":null,"messageId":"replace","endLine":286,"endColumn":40,"fix":{"range":[9684,9699],"text":"'while-editing'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":288,"column":1,"nodeType":null,"messageId":"delete","endLine":288,"endColumn":7,"fix":{"range":[9709,9715],"text":""}},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  backgroundColor: \"selectedLevels.includes(level) ? getLevelColor(level) : '#F2F2F7'\"\n}","line":298,"column":19,"nodeType":"ObjectExpression","endLine":298,"endColumn":105},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: {\n  backgroundColor: \"selectedLevels.includes(level) ? getLevelColor(level) : '#F2F2F7'\"\n}","line":298,"column":19,"nodeType":"ObjectExpression","endLine":298,"endColumn":105},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·backgroundColor:·selectedLevels.includes(level)·?·getLevelColor(level)·:·'#F2F2F7'` with `⏎····················backgroundColor:·selectedLevels.includes(level)⏎······················?·getLevelColor(level)⏎······················:·'#F2F2F7',⏎·················`","line":298,"column":20,"nodeType":null,"messageId":"replace","endLine":298,"endColumn":103,"fix":{"range":[10103,10186],"text":"\n                    backgroundColor: selectedLevels.includes(level)\n                      ? getLevelColor(level)\n                      : '#F2F2F7',\n                 "}},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  color: \"selectedLevels.includes(level) ? '#FFFFFF' : getLevelColor(level)\"\n}","line":305,"column":21,"nodeType":"ObjectExpression","endLine":305,"endColumn":97},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: {\n  color: \"selectedLevels.includes(level) ? '#FFFFFF' : getLevelColor(level)\"\n}","line":305,"column":21,"nodeType":"ObjectExpression","endLine":305,"endColumn":97},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":315,"column":1,"nodeType":null,"messageId":"delete","endLine":315,"endColumn":7,"fix":{"range":[10674,10680],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"Filter·by·category...\"` with `'Filter·by·category...'`","line":320,"column":23,"nodeType":null,"messageId":"replace","endLine":320,"endColumn":46,"fix":{"range":[10860,10883],"text":"'Filter by category...'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"while-editing\"` with `'while-editing'`","line":323,"column":27,"nodeType":null,"messageId":"replace","endLine":323,"endColumn":42,"fix":{"range":[10990,11005],"text":"'while-editing'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":328,"column":1,"nodeType":null,"messageId":"delete","endLine":328,"endColumn":3,"fix":{"range":[11048,11050],"text":""}},{"ruleId":"no-console","severity":1,"message":"Unexpected console statement. Only these console methods are allowed: warn, error.","line":333,"column":7,"nodeType":"MemberExpression","messageId":"limited","endLine":333,"endColumn":18,"suggestions":[{"fix":{"range":[11243,11304],"text":""},"messageId":"removeConsole","data":{"propertyName":"log"},"desc":"Remove the console.log()."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":338,"column":1,"nodeType":null,"messageId":"delete","endLine":338,"endColumn":3,"fix":{"range":[11392,11394],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······visible={visible}⏎······animationType=\"slide\"⏎······presentationStyle=\"fullScreen\"⏎····` with `·visible={visible}·animationType='slide'·presentationStyle='fullScreen'`","line":340,"column":11,"nodeType":null,"messageId":"replace","endLine":344,"endColumn":5,"fix":{"range":[11416,11510],"text":" visible={visible} animationType='slide' presentationStyle='fullScreen'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"download-outline\"·size={20}·color=\"#007AFF\"` with `'download-outline'·size={20}·color='#007AFF'`","line":350,"column":26,"nodeType":null,"messageId":"replace","endLine":350,"endColumn":70,"fix":{"range":[11800,11844],"text":"'download-outline' size={20} color='#007AFF'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"close\"·size={24}·color=\"#007AFF\"` with `'close'·size={24}·color='#007AFF'`","line":353,"column":26,"nodeType":null,"messageId":"replace","endLine":353,"endColumn":59,"fix":{"range":[11981,12014],"text":"'close' size={24} color='#007AFF'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":357,"column":1,"nodeType":null,"messageId":"delete","endLine":357,"endColumn":9,"fix":{"range":[12084,12092],"text":""}},{"ruleId":"@typescript-eslint/no-explicit-any","severity":1,"message":"Unexpected any. Specify a different type.","line":367,"column":54,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":367,"endColumn":57,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[12576,12579],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[12576,12579],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··················styles.tabLabel,⏎··················{·color:·activeTab·===·tab.key·?·'#007AFF'·:·'#8E8E93'·},⏎················` with `styles.tabLabel,·{·color:·activeTab·===·tab.key·?·'#007AFF'·:·'#8E8E93'·}`","line":375,"column":25,"nodeType":null,"messageId":"replace","endLine":378,"endColumn":17,"fix":{"range":[12805,12933],"text":"styles.tabLabel, { color: activeTab === tab.key ? '#007AFF' : '#8E8E93' }"}},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { color: \"activeTab === tab.key ? '#007AFF' : '#8E8E93'\" }","line":377,"column":19,"nodeType":"ObjectExpression","endLine":377,"endColumn":75},{"ruleId":"react-native/no-color-literals","severity":1,"message":"Color literal: { color: \"activeTab === tab.key ? '#007AFF' : '#8E8E93'\" }","line":377,"column":19,"nodeType":"ObjectExpression","endLine":377,"endColumn":75},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":385,"column":1,"nodeType":null,"messageId":"delete","endLine":385,"endColumn":9,"fix":{"range":[13064,13072],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":410,"column":1,"nodeType":null,"messageId":"delete","endLine":410,"endColumn":9,"fix":{"range":[13812,13820],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎`","line":725,"column":33,"nodeType":null,"messageId":"insert","endLine":725,"endColumn":33,"fix":{"range":[19499,19499],"text":"\n"}}],"suppressedMessages":[],"errorCount":54,"fatalErrorCount":0,"warningCount":13,"fixableErrorCount":53,"fixableWarningCount":0,"source":"/**\n * 🔍 Logging Dashboard Component\n * Real-time log viewer with advanced search capabilities for development and debugging\n */\n\nimport React, { useState, useEffect } from 'react';\n\nimport {\n  FlatList,\n  Modal,\n  ScrollView,\n  StyleSheet,\n  Text,\n  TextInput,\n  TouchableOpacity,\n  View,\n} from 'react-native';\n\nimport Icon from 'react-native-vector-icons/Ionicons';\n\nimport {\n  advancedLoggingService,\n  type LogEntry,\n  type LogLevel,\n  type LogQuery,\n  type LogAnalytics,\n} from '../services/AdvancedLoggingService';\n\ninterface LoggingDashboardProps {\n  visible: boolean;\n  onClose: () => void;\n}\n\nconst LoggingDashboard: React.FC<LoggingDashboardProps> = ({ visible, onClose }) => {\n  const [logs, setLogs] = useState<LogEntry[]>([]);\n  const [analytics, setAnalytics] = useState<LogAnalytics | null>(null);\n  const [searchQuery, setSearchQuery] = useState('');\n  const [selectedLevels, setSelectedLevels] = useState<LogLevel[]>([]);\n  const [selectedCategory, setSelectedCategory] = useState<string>('');\n  const [selectedLog, setSelectedLog] = useState<LogEntry | null>(null);\n  const [activeTab, setActiveTab] = useState<'logs' | 'analytics' | 'search'>('logs');\n  \n  const levels: LogLevel[] = ['trace', 'debug', 'info', 'warn', 'error', 'fatal'];\n  \n  useEffect(() => {\n    if (visible) {\n      refreshData();\n      \n      // Auto-refresh every 2 seconds while visible\n      const interval = setInterval(refreshData, 2000);\n      return () => clearInterval(interval);\n    }\n  }, [visible]);\n  \n  const refreshData = () => {\n    const query: LogQuery = {\n      query: searchQuery || undefined,\n      levels: selectedLevels.length > 0 ? selectedLevels : undefined,\n      categories: selectedCategory ? [selectedCategory] : undefined,\n      limit: 100,\n      sortBy: 'timestamp',\n      sortOrder: 'desc',\n    };\n    \n    const searchResults = advancedLoggingService.search(query);\n    setLogs(searchResults);\n    \n    const analyticsData = advancedLoggingService.getAnalytics();\n    setAnalytics(analyticsData);\n  };\n  \n  useEffect(() => {\n    if (visible) {\n      refreshData();\n    }\n  }, [searchQuery, selectedLevels, selectedCategory, visible]);\n  \n  const toggleLevel = (level: LogLevel) => {\n    setSelectedLevels(prev =>\n      prev.includes(level)\n        ? prev.filter(l => l !== level)\n        : [...prev, level]\n    );\n  };\n  \n  const getLevelColor = (level: LogLevel): string => {\n    switch (level) {\n      case 'trace':\n        return '#8E8E93';\n      case 'debug':\n        return '#007AFF';\n      case 'info':\n        return '#34C759';\n      case 'warn':\n        return '#FF9500';\n      case 'error':\n        return '#FF3B30';\n      case 'fatal':\n        return '#D70015';\n      default:\n        return '#8E8E93';\n    }\n  };\n  \n  const formatTimestamp = (timestamp: number): string => {\n    return new Date(timestamp).toLocaleTimeString();\n  };\n  \n  const renderLogItem = ({ item }: { item: LogEntry }) => (\n    <TouchableOpacity\n      style={[styles.logItem, { borderLeftColor: getLevelColor(item.level) }]}\n      onPress={() => setSelectedLog(item)}\n    >\n      <View style={styles.logHeader}>\n        <Text style={[styles.logLevel, { color: getLevelColor(item.level) }]}>\n          {item.level.toUpperCase()}\n        </Text>\n        <Text style={styles.logTime}>{formatTimestamp(item.timestamp)}</Text>\n        {item.metadata.category && (\n          <View style={[styles.categoryBadge, { backgroundColor: getLevelColor(item.level) + '20' }]}>\n            <Text style={[styles.categoryText, { color: getLevelColor(item.level) }]}>\n              {item.metadata.category}\n            </Text>\n          </View>\n        )}\n      </View>\n      \n      <Text style={styles.logMessage} numberOfLines={2}>\n        {item.message}\n      </Text>\n      \n      {item.metadata.component && (\n        <Text style={styles.logComponent}>\n          {item.metadata.screen || item.metadata.component}\n          {item.metadata.action && ` • ${item.metadata.action}`}\n        </Text>\n      )}\n    </TouchableOpacity>\n  );\n  \n  const renderLogDetails = () => {\n    if (!selectedLog) return null;\n    \n    return (\n      <Modal\n        visible={!!selectedLog}\n        animationType=\"slide\"\n        presentationStyle=\"pageSheet\"\n        onRequestClose={() => setSelectedLog(null)}\n      >\n        <View style={styles.modalContainer}>\n          <View style={styles.modalHeader}>\n            <Text style={styles.modalTitle}>Log Details</Text>\n            <TouchableOpacity\n              onPress={() => setSelectedLog(null)}\n              style={styles.closeButton}\n            >\n              <Icon name=\"close\" size={24} color=\"#007AFF\" />\n            </TouchableOpacity>\n          </View>\n          \n          <ScrollView style={styles.modalContent}>\n            <View style={styles.detailSection}>\n              <Text style={styles.detailTitle}>Basic Info</Text>\n              <Text style={styles.detailText}>Level: {selectedLog.level}</Text>\n              <Text style={styles.detailText}>Time: {new Date(selectedLog.timestamp).toLocaleString()}</Text>\n              <Text style={styles.detailText}>Platform: {selectedLog.platform}</Text>\n              <Text style={styles.detailText}>Environment: {selectedLog.environment}</Text>\n            </View>\n            \n            <View style={styles.detailSection}>\n              <Text style={styles.detailTitle}>Message</Text>\n              <Text style={styles.detailMessage}>{selectedLog.message}</Text>\n            </View>\n            \n            {selectedLog.error && (\n              <View style={styles.detailSection}>\n                <Text style={styles.detailTitle}>Error Details</Text>\n                <Text style={styles.detailText}>Name: {selectedLog.error.name}</Text>\n                <Text style={styles.detailText}>Message: {selectedLog.error.message}</Text>\n                {selectedLog.error.stack && (\n                  <ScrollView style={styles.stackTrace}>\n                    <Text style={styles.stackText}>{selectedLog.error.stack}</Text>\n                  </ScrollView>\n                )}\n              </View>\n            )}\n            \n            <View style={styles.detailSection}>\n              <Text style={styles.detailTitle}>Metadata</Text>\n              <ScrollView style={styles.metadataContainer}>\n                <Text style={styles.metadataText}>\n                  {JSON.stringify(selectedLog.metadata, null, 2)}\n                </Text>\n              </ScrollView>\n            </View>\n          </ScrollView>\n        </View>\n      </Modal>\n    );\n  };\n  \n  const renderAnalytics = () => {\n    if (!analytics) return null;\n    \n    return (\n      <ScrollView style={styles.analyticsContainer}>\n        <View style={styles.analyticsSection}>\n          <Text style={styles.analyticsTitle}>Overview</Text>\n          <View style={styles.statRow}>\n            <View style={styles.statCard}>\n              <Text style={styles.statValue}>{analytics.totalLogs}</Text>\n              <Text style={styles.statLabel}>Total Logs</Text>\n            </View>\n            <View style={styles.statCard}>\n              <Text style={[styles.statValue, { color: '#FF3B30' }]}>\n                {(analytics.performanceMetrics.errorRate * 100).toFixed(1)}%\n              </Text>\n              <Text style={styles.statLabel}>Error Rate</Text>\n            </View>\n          </View>\n        </View>\n        \n        <View style={styles.analyticsSection}>\n          <Text style={styles.analyticsTitle}>Logs by Level</Text>\n          {levels.map(level => {\n            const count = analytics.logsByLevel[level] || 0;\n            const percentage = analytics.totalLogs > 0 ? (count / analytics.totalLogs) * 100 : 0;\n            \n            return (\n              <View key={level} style={styles.levelRow}>\n                <Text style={[styles.levelName, { color: getLevelColor(level) }]}>\n                  {level.toUpperCase()}\n                </Text>\n                <View style={styles.levelBar}>\n                  <View\n                    style={[\n                      styles.levelBarFill,\n                      {\n                        backgroundColor: getLevelColor(level),\n                        width: `${percentage}%`,\n                      },\n                    ]}\n                  />\n                </View>\n                <Text style={styles.levelCount}>{count}</Text>\n              </View>\n            );\n          })}\n        </View>\n        \n        <View style={styles.analyticsSection}>\n          <Text style={styles.analyticsTitle}>Categories</Text>\n          {Object.entries(analytics.logsByCategory).map(([category, count]) => (\n            <View key={category} style={styles.categoryRow}>\n              <Text style={styles.categoryName}>{category}</Text>\n              <Text style={styles.categoryCount}>{count}</Text>\n            </View>\n          ))}\n        </View>\n        \n        {analytics.topErrors.length > 0 && (\n          <View style={styles.analyticsSection}>\n            <Text style={styles.analyticsTitle}>Top Errors</Text>\n            {analytics.topErrors.map((error, index) => (\n              <View key={index} style={styles.errorRow}>\n                <Text style={styles.errorMessage} numberOfLines={2}>\n                  {error.message}\n                </Text>\n                <Text style={styles.errorCount}>×{error.count}</Text>\n              </View>\n            ))}\n          </View>\n        )}\n      </ScrollView>\n    );\n  };\n  \n  const renderSearch = () => (\n    <View style={styles.searchContainer}>\n      <TextInput\n        style={styles.searchInput}\n        placeholder=\"Search logs...\"\n        value={searchQuery}\n        onChangeText={setSearchQuery}\n        clearButtonMode=\"while-editing\"\n      />\n      \n      <View style={styles.filterSection}>\n        <Text style={styles.filterTitle}>Levels</Text>\n        <ScrollView horizontal showsHorizontalScrollIndicator={false}>\n          <View style={styles.filterRow}>\n            {levels.map(level => (\n              <TouchableOpacity\n                key={level}\n                style={[\n                  styles.levelFilter,\n                  { backgroundColor: selectedLevels.includes(level) ? getLevelColor(level) : '#F2F2F7' },\n                ]}\n                onPress={() => toggleLevel(level)}\n              >\n                <Text\n                  style={[\n                    styles.levelFilterText,\n                    { color: selectedLevels.includes(level) ? '#FFFFFF' : getLevelColor(level) },\n                  ]}\n                >\n                  {level.toUpperCase()}\n                </Text>\n              </TouchableOpacity>\n            ))}\n          </View>\n        </ScrollView>\n      </View>\n      \n      <View style={styles.filterSection}>\n        <Text style={styles.filterTitle}>Category</Text>\n        <TextInput\n          style={styles.categoryInput}\n          placeholder=\"Filter by category...\"\n          value={selectedCategory}\n          onChangeText={setSelectedCategory}\n          clearButtonMode=\"while-editing\"\n        />\n      </View>\n    </View>\n  );\n  \n  const exportLogs = async () => {\n    try {\n      const logsJson = await advancedLoggingService.exportLogs('json');\n      // In a real app, you'd use a sharing library or save to files\n      console.log('Logs exported:', logsJson.length, 'characters');\n    } catch (error) {\n      console.error('Failed to export logs:', error);\n    }\n  };\n  \n  return (\n    <Modal\n      visible={visible}\n      animationType=\"slide\"\n      presentationStyle=\"fullScreen\"\n    >\n      <View style={styles.container}>\n        <View style={styles.header}>\n          <Text style={styles.title}>Logging Dashboard</Text>\n          <View style={styles.headerButtons}>\n            <TouchableOpacity onPress={exportLogs} style={styles.exportButton}>\n              <Icon name=\"download-outline\" size={20} color=\"#007AFF\" />\n            </TouchableOpacity>\n            <TouchableOpacity onPress={onClose} style={styles.closeButton}>\n              <Icon name=\"close\" size={24} color=\"#007AFF\" />\n            </TouchableOpacity>\n          </View>\n        </View>\n        \n        <View style={styles.tabBar}>\n          {[\n            { key: 'logs', label: 'Logs', icon: 'list-outline' },\n            { key: 'analytics', label: 'Analytics', icon: 'analytics-outline' },\n            { key: 'search', label: 'Search', icon: 'search-outline' },\n          ].map(tab => (\n            <TouchableOpacity\n              key={tab.key}\n              style={[styles.tab, activeTab === tab.key && styles.activeTab]}\n              onPress={() => setActiveTab(tab.key as any)}\n            >\n              <Icon\n                name={tab.icon}\n                size={20}\n                color={activeTab === tab.key ? '#007AFF' : '#8E8E93'}\n              />\n              <Text\n                style={[\n                  styles.tabLabel,\n                  { color: activeTab === tab.key ? '#007AFF' : '#8E8E93' },\n                ]}\n              >\n                {tab.label}\n              </Text>\n            </TouchableOpacity>\n          ))}\n        </View>\n        \n        <View style={styles.content}>\n          {activeTab === 'logs' && (\n            <FlatList\n              data={logs}\n              renderItem={renderLogItem}\n              keyExtractor={item => item.id}\n              refreshing={false}\n              onRefresh={refreshData}\n              style={styles.logsList}\n            />\n          )}\n          {activeTab === 'analytics' && renderAnalytics()}\n          {activeTab === 'search' && (\n            <>\n              {renderSearch()}\n              <FlatList\n                data={logs}\n                renderItem={renderLogItem}\n                keyExtractor={item => item.id}\n                style={styles.searchResults}\n              />\n            </>\n          )}\n        </View>\n        \n        {renderLogDetails()}\n      </View>\n    </Modal>\n  );\n};\n\nconst styles = StyleSheet.create({\n  container: {\n    flex: 1,\n    backgroundColor: '#F2F2F7',\n  },\n  header: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    padding: 16,\n    paddingTop: 50,\n    backgroundColor: '#FFFFFF',\n    borderBottomWidth: StyleSheet.hairlineWidth,\n    borderBottomColor: '#E5E5EA',\n  },\n  title: {\n    fontSize: 18,\n    fontWeight: '600',\n    color: '#1C1C1E',\n  },\n  headerButtons: {\n    flexDirection: 'row',\n    gap: 12,\n  },\n  exportButton: {\n    padding: 8,\n  },\n  closeButton: {\n    padding: 8,\n  },\n  tabBar: {\n    flexDirection: 'row',\n    backgroundColor: '#FFFFFF',\n    borderBottomWidth: StyleSheet.hairlineWidth,\n    borderBottomColor: '#E5E5EA',\n  },\n  tab: {\n    flex: 1,\n    flexDirection: 'row',\n    alignItems: 'center',\n    justifyContent: 'center',\n    padding: 12,\n    gap: 6,\n  },\n  activeTab: {\n    borderBottomWidth: 2,\n    borderBottomColor: '#007AFF',\n  },\n  tabLabel: {\n    fontSize: 14,\n    fontWeight: '500',\n  },\n  content: {\n    flex: 1,\n  },\n  logsList: {\n    flex: 1,\n  },\n  logItem: {\n    backgroundColor: '#FFFFFF',\n    marginHorizontal: 16,\n    marginVertical: 4,\n    padding: 12,\n    borderRadius: 8,\n    borderLeftWidth: 4,\n  },\n  logHeader: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: 4,\n    gap: 8,\n  },\n  logLevel: {\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  logTime: {\n    fontSize: 12,\n    color: '#8E8E93',\n  },\n  categoryBadge: {\n    paddingHorizontal: 6,\n    paddingVertical: 2,\n    borderRadius: 4,\n  },\n  categoryText: {\n    fontSize: 10,\n    fontWeight: '500',\n  },\n  logMessage: {\n    fontSize: 14,\n    color: '#1C1C1E',\n    marginBottom: 4,\n  },\n  logComponent: {\n    fontSize: 12,\n    color: '#8E8E93',\n  },\n  modalContainer: {\n    flex: 1,\n    backgroundColor: '#F2F2F7',\n  },\n  modalHeader: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    padding: 16,\n    backgroundColor: '#FFFFFF',\n    borderBottomWidth: StyleSheet.hairlineWidth,\n    borderBottomColor: '#E5E5EA',\n  },\n  modalTitle: {\n    fontSize: 18,\n    fontWeight: '600',\n    color: '#1C1C1E',\n  },\n  modalContent: {\n    flex: 1,\n    padding: 16,\n  },\n  detailSection: {\n    backgroundColor: '#FFFFFF',\n    borderRadius: 8,\n    padding: 16,\n    marginBottom: 16,\n  },\n  detailTitle: {\n    fontSize: 16,\n    fontWeight: '600',\n    color: '#1C1C1E',\n    marginBottom: 8,\n  },\n  detailText: {\n    fontSize: 14,\n    color: '#3C3C43',\n    marginBottom: 4,\n  },\n  detailMessage: {\n    fontSize: 14,\n    color: '#1C1C1E',\n    lineHeight: 20,\n  },\n  stackTrace: {\n    maxHeight: 200,\n    backgroundColor: '#F2F2F7',\n    borderRadius: 4,\n    padding: 8,\n    marginTop: 8,\n  },\n  stackText: {\n    fontSize: 12,\n    fontFamily: 'Menlo',\n    color: '#3C3C43',\n  },\n  metadataContainer: {\n    maxHeight: 200,\n    backgroundColor: '#F2F2F7',\n    borderRadius: 4,\n    padding: 8,\n  },\n  metadataText: {\n    fontSize: 12,\n    fontFamily: 'Menlo',\n    color: '#3C3C43',\n  },\n  analyticsContainer: {\n    padding: 16,\n  },\n  analyticsSection: {\n    backgroundColor: '#FFFFFF',\n    borderRadius: 8,\n    padding: 16,\n    marginBottom: 16,\n  },\n  analyticsTitle: {\n    fontSize: 16,\n    fontWeight: '600',\n    color: '#1C1C1E',\n    marginBottom: 12,\n  },\n  statRow: {\n    flexDirection: 'row',\n    gap: 12,\n  },\n  statCard: {\n    flex: 1,\n    alignItems: 'center',\n    padding: 12,\n    backgroundColor: '#F2F2F7',\n    borderRadius: 8,\n  },\n  statValue: {\n    fontSize: 24,\n    fontWeight: '700',\n    color: '#1C1C1E',\n  },\n  statLabel: {\n    fontSize: 12,\n    color: '#8E8E93',\n    marginTop: 4,\n  },\n  levelRow: {\n    flexDirection: 'row',\n    alignItems: 'center',\n    marginBottom: 8,\n    gap: 8,\n  },\n  levelName: {\n    fontSize: 12,\n    fontWeight: '600',\n    width: 60,\n  },\n  levelBar: {\n    flex: 1,\n    height: 8,\n    backgroundColor: '#E5E5EA',\n    borderRadius: 4,\n  },\n  levelBarFill: {\n    height: '100%',\n    borderRadius: 4,\n  },\n  levelCount: {\n    fontSize: 12,\n    color: '#3C3C43',\n    width: 40,\n    textAlign: 'right',\n  },\n  categoryRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    paddingVertical: 4,\n  },\n  categoryName: {\n    fontSize: 14,\n    color: '#1C1C1E',\n  },\n  categoryCount: {\n    fontSize: 14,\n    color: '#8E8E93',\n    fontWeight: '600',\n  },\n  errorRow: {\n    flexDirection: 'row',\n    justifyContent: 'space-between',\n    alignItems: 'center',\n    paddingVertical: 8,\n    borderBottomWidth: StyleSheet.hairlineWidth,\n    borderBottomColor: '#E5E5EA',\n  },\n  errorMessage: {\n    fontSize: 14,\n    color: '#FF3B30',\n    flex: 1,\n    marginRight: 8,\n  },\n  errorCount: {\n    fontSize: 14,\n    color: '#8E8E93',\n    fontWeight: '600',\n  },\n  searchContainer: {\n    backgroundColor: '#FFFFFF',\n    padding: 16,\n    borderBottomWidth: StyleSheet.hairlineWidth,\n    borderBottomColor: '#E5E5EA',\n  },\n  searchInput: {\n    backgroundColor: '#F2F2F7',\n    borderRadius: 8,\n    padding: 12,\n    fontSize: 16,\n    marginBottom: 16,\n  },\n  filterSection: {\n    marginBottom: 12,\n  },\n  filterTitle: {\n    fontSize: 14,\n    fontWeight: '600',\n    color: '#1C1C1E',\n    marginBottom: 8,\n  },\n  filterRow: {\n    flexDirection: 'row',\n    gap: 8,\n  },\n  levelFilter: {\n    paddingHorizontal: 12,\n    paddingVertical: 6,\n    borderRadius: 16,\n  },\n  levelFilterText: {\n    fontSize: 12,\n    fontWeight: '600',\n  },\n  categoryInput: {\n    backgroundColor: '#F2F2F7',\n    borderRadius: 8,\n    padding: 12,\n    fontSize: 14,\n  },\n  searchResults: {\n    flex: 1,\n  },\n});\n\nexport default LoggingDashboard;","usedDeprecatedRules":[{"ruleId":"jsx-a11y/accessible-emoji","replacedBy":[]},{"ruleId":"unicorn/no-instanceof-array","replacedBy":[""],"info":{"message":"Replaced by `unicorn/no-instanceof-builtins` which covers more cases.","url":"https://github.com/sindresorhus/eslint-plugin-unicorn/blob/v59.0.1/docs/deprecated-rules.md#no-instanceof-array","replacedBy":["unicorn/no-instanceof-builtins"]}}]},{"filePath":"/Users/yogibairagi/Developer/Personal Projects/Kindred/src/components/MicroInteractions.tsx","messages":[{"ruleId":"no-duplicate-imports","severity":2,"message":"'react-native' import is duplicated.","line":4,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":4,"endColumn":70},{"ruleId":"no-duplicate-imports","severity":2,"message":"'react-native-gesture-handler' import is duplicated.","line":7,"column":1,"nodeType":"ImportDeclaration","messageId":"import","endLine":7,"endColumn":83},{"ruleId":"@typescript-eslint/prefer-nullish-coalescing","severity":2,"message":"Prefer using nullish coalescing operator (`??`) instead of a logical or (`||`), as it is a safer operator.","line":168,"column":34,"nodeType":"Punctuator","messageId":"preferNullishOverOr","endLine":168,"endColumn":36,"suggestions":[{"messageId":"suggestNullish","data":{"equals":""},"fix":{"range":[4439,4441],"text":"??"},"desc":"Fix to nullish coalescing operator (`??`)."}]},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { overflow: 'hidden' }","line":186,"column":22,"nodeType":"ObjectExpression","endLine":186,"endColumn":44},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: { position: 'relative' }","line":318,"column":19,"nodeType":"ObjectExpression","endLine":318,"endColumn":43},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  position: 'absolute',\n  left: 0,\n  top: 0,\n  bottom: 0,\n  justifyContent: 'center',\n  paddingLeft: 20\n}","line":323,"column":13,"nodeType":"ObjectExpression","endLine":330,"endColumn":14},{"ruleId":"react-native/no-inline-styles","severity":1,"message":"Inline style: {\n  position: 'absolute',\n  right: 0,\n  top: 0,\n  bottom: 0,\n  justifyContent: 'center',\n  paddingRight: 20\n}","line":342,"column":13,"nodeType":"ObjectExpression","endLine":349,"endColumn":14},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'scaleAnim'. Either include it or remove the dependency array.","line":410,"column":6,"nodeType":"ArrayExpression","endLine":410,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [scaleAnim]","fix":{"range":[10376,10378],"text":"[