rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid} (Matches Firebase Auth UID)
    // Fields:
    //   - uid: string (optional, must match request.auth.uid)
    //   - displayName: string (optional, max 100 chars)
    //   - email: string (optional, max 150 chars)
    //   - avatar: string (optional, max 1000 chars)
    //   - bio: string (optional, max 1000 chars)
    //   - location: map (optional)
    //   - privacy: map (optional)
    //   - preferences: map (optional)
    //   - stats: map (optional)
    //   - carbon: map (optional)
    //   - achievements: list (optional, max 200 items)
    //   - badges: list (optional, max 200 items)
    //   - wallet: map (server-authoritative; client create allowed only with balanceCents == 0 and totalEarnedCents == 0; immutable on client update)
    //       - balanceCents: number (must be 0 on create)
    //       - totalEarnedCents: number (must be 0 on create)
    //   - corporate: map (server-authoritative verification; client create allowed only with isVerified == false or omitted; immutable on client update)
    //       - linkedCompany: string (optional, max 200 chars)
    //       - companyDomain: string (optional, max 200 chars)
    //       - isLinked: bool (optional)
    //       - isVerified: bool (server-managed; cannot be true on client create)
    //   - sdg: map (server-authoritative score; client create allowed only with total == 0 or omitted; immutable on client update)
    //       - esg: map (optional)
    //           - total: number (must be 0 on create)
    //
    // Subcollection: users/{uid}/transactions/{txId}
    //   - Read: Allowed for document owner (request.auth.uid == uid)
    //   - Write: Denied for all clients (allow write: if false).
    //     All financial transactions are strictly server-managed by Cloud Functions
    //     (payoutToUPI, redeemVoucher, onAdRewardVerified).
    //
    // Subcollection: users/{uid}/history/{historyId}
    //   - Read: Allowed for document owner (request.auth.uid == uid)
    //   - Create: Allowed for document owner with validated schema (points <= 10000, bounded strings)
    //   - Update / Delete: Denied
    //
    // Subcollection: users/{uid}/_rateLimits/{docId}
    //   - Server-only internal tracking (allow read, write: if false)
    //
    // Collection: companies/{domain}
    //   - Read: Allowed for authenticated users (corporate leaderboard)
    //   - Write: Denied for clients (allow write: if false; Cloud Functions only)
    //
    // Collection: verifications/{uid}
    //   - Server-only email OTP verification secrets (allow read, write: if false)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) || data[field] == null || (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalMap(data, field) {
      return !(field in data) || data[field] == null || (data[field] is map);
    }

    // Domain Validator for users: enforces type safety, UID integrity, and bounds
    function isValidUser(data) {
      return (!('uid' in data) || (data.uid is string && data.uid == request.auth.uid)) &&
        isValidOptionalString(data, 'displayName', 100) &&
        isValidOptionalString(data, 'email', 150) &&
        isValidOptionalString(data, 'avatar', 1000) &&
        isValidOptionalString(data, 'bio', 1000) &&
        isValidOptionalList(data, 'achievements', 200) &&
        isValidOptionalList(data, 'badges', 200) &&
        isValidOptionalMap(data, 'location') &&
        isValidOptionalMap(data, 'privacy') &&
        isValidOptionalMap(data, 'preferences') &&
        isValidOptionalMap(data, 'stats') &&
        isValidOptionalMap(data, 'carbon') &&
        isValidOptionalMap(data, 'wallet') &&
        isValidOptionalMap(data, 'corporate') &&
        isValidOptionalMap(data, 'sdg');
    }

    // Validates wallet initialization on create: client cannot initialize non-zero balances
    function isValidWalletOnCreate(data) {
      return !('wallet' in data) ||
        (
          data.wallet is map &&
          (!('balanceCents' in data.wallet) || (data.wallet.balanceCents is number && data.wallet.balanceCents == 0)) &&
          (!('totalEarnedCents' in data.wallet) || (data.wallet.totalEarnedCents is number && data.wallet.totalEarnedCents == 0))
        );
    }

    // Validates corporate status on create: client cannot mark company as verified
    function isValidCorporateOnCreate(data) {
      return !('corporate' in data) ||
        (
          data.corporate is map &&
          (!('isVerified' in data.corporate) || (data.corporate.isVerified is bool && data.corporate.isVerified == false)) &&
          isValidOptionalString(data.corporate, 'linkedCompany', 200) &&
          isValidOptionalString(data.corporate, 'companyDomain', 200)
        );
    }

    // Validates SDG scores on create: client cannot initialize non-zero ESG scores
    function isValidSdgOnCreate(data) {
      return !('sdg' in data) ||
        (
          data.sdg is map &&
          (!('esg' in data.sdg) ||
            (data.sdg.esg is map &&
              (!('total' in data.sdg.esg) || (data.sdg.esg.total is number && data.sdg.esg.total == 0))
            )
          )
        );
    }

    // Validates activity history log entry (DoS protection and valid points range)
    function isValidHistoryItem(data) {
      return (!('points' in data) || (data.points is number && data.points >= 0 && data.points <= 10000)) &&
        isValidOptionalString(data, 'title', 200) &&
        isValidOptionalString(data, 'type', 100) &&
        isValidOptionalString(data, 'description', 1000);
    }

    // ===============================================================
    // USERS Collection & Subcollections
    // ===============================================================
    match /users/{uid} {
      // Authenticated users can read profiles (needed for leaderboards and social feed)
      allow read: if isAuthenticated();

      // Client can only create their own user document with zero wallet balances,
      // unverified corporate status, and zero ESG score
      allow create: if isOwner(uid) &&
                       isValidUser(request.resource.data) &&
                       isValidWalletOnCreate(request.resource.data) &&
                       isValidCorporateOnCreate(request.resource.data) &&
                       isValidSdgOnCreate(request.resource.data);

      // Client can update their own profile, but CANNOT modify server-authoritative fields (wallet, sdg, corporate).
      // All financial balance changes, SDG calculations, and corporate verifications are managed server-side.
      allow update: if isOwner(uid) &&
                       isValidUser(request.resource.data) &&
                       (!('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(['wallet', 'sdg', 'corporate']);

      // Account deletion is server-managed only
      allow delete: if false;

      // Legacy/subcollection safety match: wallet is a map on users/{uid},
      // but any subcollection write is explicitly denied.
      match /wallet/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Financial transactions: strictly server-managed by Cloud Functions (payoutToUPI, redeemVoucher, onAdRewardVerified).
      // Users may read their own transaction history, but all client writes are disabled to prevent forged transactions.
      match /transactions/{txId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Activity history: client may log activity (triggers onActivityLogged Cloud Function), and read own
      match /history/{historyId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && isValidHistoryItem(request.resource.data);
        allow update: if false;
        allow delete: if false;
      }

      // Rate-limit tracker is server-only (written and read by Cloud Functions)
      match /_rateLimits/{docId} {
        allow read, write: if false;
      }
    }

    // =============================================================
    // COMPANIES — corporate leaderboard: readable by authenticated
    // users, written only by Cloud Functions (onActivityLogged)
    // =============================================================
    match /companies/{domain} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // =============================================================
    // VERIFICATIONS — email OTP codes are server-only, never client-visible
    // =============================================================
    match /verifications/{uid} {
      allow read, write: if false;
    }

    // =============================================================
    // Root Default Deny Fallback
    // =============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
