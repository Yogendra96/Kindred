{
  "name": "Kindred",
  "displayName": "Kindred",
  "expo": {
    "name": "Kindred",
    "slug": "kindred",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kindred.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to track your eco-friendly activities",
        "NSLocationAlwaysUsageDescription": "We need your location to track your eco-friendly activities in the background",
        "NSCameraUsageDescription": "We need camera access to let you take photos for your profile",
        "NSPhotoLibraryUsageDescription": "We need photo library access to let you choose profile pictures",
        "UIBackgroundModes": ["location", "fetch"]
      }
    },
    "android": {
      "package": "com.kindred.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
