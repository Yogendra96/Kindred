{
  "name": "Kindred",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:release": "react-native run-android --variant=release",
    "android:clean": "cd android && ./gradlew clean",
    "ios": "react-native run-ios",
    "ios:release": "react-native run-ios --configuration Release",
    "ios:clean": "cd ios && xcodebuild clean -workspace Kindred.xcworkspace -scheme Kindred",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "start:verbose": "react-native start --verbose",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "test": "jest --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "test:unit": "jest --selectProjects='Unit Tests'",
    "test:integration": "jest --selectProjects='Integration Tests'",
    "test:e2e": "detox test",
    "test:e2e:build": "detox build",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:maestro": "maestro test .maestro",
    "test:performance": "jest --testNamePattern='performance'",
    "test:accessibility": "jest --testNamePattern='accessibility'",
    "test:ci": "jest --coverage --watchAll=false --ci",
    "clean": "rimraf node_modules && rm -rf package-lock.json bun.lockb && bun install",
    "clean:metro": "rm -rf .metro-cache && rm -rf /tmp/metro-* && rm -rf /tmp/haste-map-*",
    "clean:watchman": "watchman watch-del-all",
    "clean:pods": "cd ios && rm -rf Pods && rm -rf Podfile.lock",
    "clean:gradle": "cd android && ./gradlew clean && rm -rf .gradle",
    "clean:all": "bun run clean && bun run clean:metro && bun run clean:watchman && bun run clean:pods && bun run clean:gradle",
    "reset": "bun run clean:all && bun install && bun run pod:install",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "pod:install": "cd ios && pod install --repo-update",
    "pod:update": "cd ios && pod update",
    "prepare": "husky install",
    "commitlint": "commitlint --edit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "validate": "bun run lint && bun run typecheck && bun run test:ci",
    "validate:quick": "bun run lint && bun run typecheck",
    "postinstall": "bun run pod:install && patch-package",
    "precommit": "bun run lint:staged && bun run typecheck",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "bundle:analyze": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android-bundle.js --verbose",
    "bundle:ios": "npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios-bundle.js",
    "flipper:clean": "rm -rf ~/.flipper",
    "doctor": "npx react-native doctor",
    "info": "npx react-native info",
    "dev:env": "npx react-native config",
    "security:audit": "bun audit",
    "security:check": "npx audit-ci --config audit-ci.json",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && bun install",
    "release:patch": "npm version patch && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:major": "npm version major && git push --tags"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.6",
    "@reduxjs/toolkit": "^2.0.1",
    "react-redux": "^9.0.4",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/stack": "^6.3.20",
    "@react-navigation/native-stack": "^6.9.17",
    "react-native-safe-area-context": "^4.8.2",
    "react-native-screens": "^3.29.0",
    "react-native-gesture-handler": "^2.14.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-firebase/app": "^19.0.1",
    "@react-native-firebase/auth": "^19.0.1",
    "@react-native-firebase/firestore": "^19.0.1",
    "@react-native-firebase/analytics": "^19.0.1",
    "@react-native-firebase/messaging": "^19.0.1",
    "@react-native-firebase/storage": "^19.0.1",
    "@react-native-google-signin/google-signin": "^10.1.0",
    "@tensorflow/tfjs": "^4.15.0",
    "@tensorflow/tfjs-react-native": "^0.8.0",
    "@tensorflow/tfjs-platform-react-native": "^0.8.0",
    "crypto-js": "^4.2.0",
    "react-native-keychain": "^8.2.0",
    "react-native-device-info": "^10.13.0",
    "@react-native-community/netinfo": "^11.2.1",
    "expo-location": "^16.5.4",
    "expo-task-manager": "^11.6.0",
    "expo-camera": "^14.0.5",
    "expo-barcode-scanner": "^12.7.2",
    "expo-haptics": "^12.6.0",
    "expo-linear-gradient": "^12.6.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-svg": "^14.1.0",
    "react-native-vector-icons": "^10.0.3",
    "react-native-image-picker": "^7.1.0",
    "react-native-permissions": "^4.1.0",
    "react-native-share": "^10.0.2",
    "react-native-maps": "^1.10.0",
    "@notifee/react-native": "^7.8.2",
    "react-native-mmkv": "^2.11.0",
    "react-native-vision-camera": "^3.6.17",
    "axios": "^1.6.5",
    "date-fns": "^3.2.0",
    "uuid": "^9.0.1",
    "react-hook-form": "^7.48.2",
    "react-native-config": "^1.5.1",
    "react-native-flipper": "^0.212.0",
    "react-native-fast-image": "^8.6.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/uuid": "^9.0.7",
    "detox": "^20.13.5",
    "patch-package": "^8.0.0",
    "react-native-dotenv": "^3.4.9",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^8.19.0",
    "husky": "^9.0.0",
    "jest": "^29.6.3",
    "lint-staged": "^15.0.0",
    "metro-react-native-babel-preset": "0.77.0",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "sort-package-json": "^2.0.0",
    "typescript": "5.0.4"
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "jest",
        "config": "e2e/jest.config.js"
      },
      "jest": {
        "setupFilesAfterEnv": ["./e2e/init.js"]
      }
    },
    "apps": {
      "ios": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/Kindred.app",
        "build": "xcodebuild -workspace ios/Kindred.xcworkspace -scheme Kindred -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      },
      "android": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15 Pro"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_7_API_34"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android"
      }
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  }
}
