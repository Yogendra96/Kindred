{
  "name": "Kindred",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "android:clean": "cd android && ./gradlew clean",
    "android:release": "react-native run-android --variant=release",
    "bundle:analyze": "npx react-native bundle --platform android --dev false --entry-file index.js --bundle-output android-bundle.js --verbose",
    "bundle:check": "bundlesize",
    "bundle:ios": "npx react-native bundle --platform ios --dev false --entry-file index.js --bundle-output ios-bundle.js",
    "clean": "rimraf node_modules && rm -rf package-lock.json bun.lockb && bun install",
    "clean:all": "bun run clean && bun run clean:metro && bun run clean:watchman && bun run clean:pods && bun run clean:gradle",
    "clean:gradle": "cd android && ./gradlew clean && rm -rf .gradle",
    "clean:metro": "rm -rf .metro-cache && rm -rf /tmp/metro-* && rm -rf /tmp/haste-map-*",
    "clean:pods": "cd ios && rm -rf Pods && rm -rf Podfile.lock",
    "clean:watchman": "watchman watch-del-all",
    "commitlint": "commitlint --edit",
    "danger:ci": "danger ci",
    "danger:local": "danger local",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && bun install",
    "dev:env": "npx react-native config",
    "doctor": "npx react-native doctor",
    "flipper:clean": "rm -rf ~/.flipper",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "hooks:install": "husky install",
    "hooks:test": "echo '✅ Testing hooks...' && bun run validate:branch && echo '✅ Branch name validation passed'",
    "info": "npx react-native info",
    "ios": "react-native run-ios",
    "ios:clean": "cd ios && xcodebuild clean -workspace Kindred.xcworkspace -scheme Kindred",
    "ios:release": "react-native run-ios --configuration Release",
    "license:check": "license-checker --production --onlyAllow 'MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;CC0-1.0;Unlicense'",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "lint:staged": "lint-staged",
    "pod:install": "cd ios && pod install --repo-update",
    "pod:update": "cd ios && pod update",
    "postinstall:disabled": "bun run pod:install && patch-package",
    "precommit": "bun run lint:staged && bun run typecheck",
    "prepare": "husky install",
    "release:major": "npm version major && git push --tags",
    "release:minor": "npm version minor && git push --tags",
    "release:patch": "npm version patch && git push --tags",
    "reset": "bun run clean:all && bun install && bun run pod:install",
    "security:audit": "bun audit",
    "security:check": "npx audit-ci --config audit-ci.json",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "start:verbose": "react-native start --verbose",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:test": "test-storybook",
    "test": "jest --coverage --watchAll=false",
    "test:accessibility": "jest --testNamePattern='accessibility'",
    "test:ci": "jest --coverage --watchAll=false --ci",
    "test:e2e": "detox test",
    "test:e2e:android": "detox test --configuration android.emu.debug",
    "test:e2e:build": "detox build",
    "test:e2e:ios": "detox test --configuration ios.sim.debug",
    "test:integration": "jest --selectProjects='Integration Tests'",
    "test:maestro": "maestro test .maestro",
    "test:performance": "jest --testNamePattern='performance'",
    "test:unit": "jest --selectProjects='Unit Tests'",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "bun run lint && bun run typecheck && bun run test:ci",
    "validate:branch": "validate-branch-name",
    "validate:quick": "bun run lint && bun run typecheck"
  },
  "resolutions": {
    "@types/react": "^18.2.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^1.24.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.10",
    "@reduxjs/toolkit": "^2.7.0",
    "@sentry/react-native": "^8.2.0",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/react": "^10.2.13",
    "@tanstack/react-query": "^5.90.21",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "expo-barcode-scanner": "^13.0.1",
    "expo-blur": "^55.0.8",
    "expo-camera": "^55.0.9",
    "expo-haptics": "^55.0.8",
    "expo-image-manipulator": "^55.0.9",
    "expo-image-picker": "^55.0.9",
    "expo-linear-gradient": "^55.0.8",
    "expo-location": "^55.1.2",
    "expo-task-manager": "^55.0.9",
    "react": "18.2.0",
    "react-native": "^0.81.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^2.25.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-maps": "1.14.0",
    "react-native-reanimated": "^3.18.0",
    "react-native-safe-area-context": "^5.5.0",
    "react-native-screens": "^4.10.1",
    "react-native-svg": "^15.15.3",
    "react-native-vector-icons": "^10.3.0",
    "react-native-vision-camera": "^4.7.3",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "vision-camera-code-scanner": "^0.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.20.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/runtime": "^7.20.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@react-native/babel-preset": "^0.81.1",
    "@react-native/eslint-config": "^0.81.1",
    "@react-native/metro-config": "^0.81.1",
    "@react-native/typescript-config": "^0.81.1",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^12.4.3",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.2.6",
    "@types/react-native-maps": "^0.24.2",
    "@types/react-test-renderer": "^18.0.0",
    "@types/uuid": "^9.0.7",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "bundlesize": "^0.18.2",
    "danger": "^13.0.4",
    "detox": "^20.13.5",
    "eslint": "^8.19.0",
    "eslint-plugin-testing-library": "^7.11.0",
    "husky": "^9.0.0",
    "jest": "^29.6.3",
    "jest-watch-typeahead": "^3.0.1",
    "license-checker": "^25.0.1",
    "lint-staged": "^15.0.0",
    "metro-react-native-babel-preset": "0.77.0",
    "patch-package": "^8.0.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.9",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "18.2.0",
    "sort-package-json": "^2.0.0",
    "typescript": "5.0.4",
    "validate-branch-name": "^1.3.2"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=18.0.0"
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "jest",
        "config": "e2e/jest.config.js"
      },
      "jest": {
        "setupFilesAfterEnv": [
          "./e2e/init.js"
        ]
      }
    },
    "apps": {
      "ios": {
        "type": "ios.app",
        "binaryPath": "ios/build/Build/Products/Debug-iphonesimulator/Kindred.app",
        "build": "xcodebuild -workspace ios/Kindred.xcworkspace -scheme Kindred -configuration Debug -sdk iphonesimulator -derivedDataPath ios/build"
      },
      "android": {
        "type": "android.apk",
        "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
        "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug"
      }
    },
    "devices": {
      "simulator": {
        "type": "ios.simulator",
        "device": {
          "type": "iPhone 15 Pro"
        }
      },
      "emulator": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_9_Pro_XL_API_35"
        }
      }
    },
    "configurations": {
      "ios.sim.debug": {
        "device": "simulator",
        "app": "ios"
      },
      "android.emu.debug": {
        "device": "emulator",
        "app": "android"
      }
    }
  }
}
