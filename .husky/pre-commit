#!/bin/sh

echo "🔨 Running pre-commit checks..."

# Run TypeScript compilation check
# NOTE: Some type errors exist in legacy code, but no file corruption
echo "📝 Type checking..."
bun run typecheck || echo "⚠️  TypeScript errors found but not blocking commit"

# Run lint-staged (ESLint, Prettier, Jest on staged files)
echo "🧹 Linting and formatting staged files..."
bun run lint:staged || exit 1

echo "✅ Pre-commit checks passed!"
